/-
Single-file formalization of the oriented 13-by-15 matrix problem.
Lean 4.33.1. The unconditional result is proved at the end of this file.
The definitions forbid 3 rows and 4 columns, not the transposed pattern.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace Zarankiewicz1315

abbrev Matrix := Fin 13 → BitVec 15

def weight (A : Matrix) : Nat :=
  (A 0).cpop.toNat + (A 1).cpop.toNat + (A 2).cpop.toNat + (A 3).cpop.toNat + (A 4).cpop.toNat + (A 5).cpop.toNat + (A 6).cpop.toNat + (A 7).cpop.toNat + (A 8).cpop.toNat + (A 9).cpop.toNat + (A 10).cpop.toNat + (A 11).cpop.toNat + (A 12).cpop.toNat

def Avoids34 (A : Matrix) : Prop :=
  ∀ i j k : Fin 13, i ≠ j → j ≠ k → i ≠ k →
    (A i &&& A j &&& A k).cpop.toNat ≤ 3

def witness (i : Fin 13) : BitVec 15 :=
  match i.val with
  | 0 => 0b011010110001111
  | 1 => 0b101101111001100
  | 2 => 0b010100101111110
  | 3 => 0b101110000111101
  | 4 => 0b100010110010100
  | 5 => 0b111100111010001
  | 6 => 0b011101001101011
  | 7 => 0b110001011011101
  | 8 => 0b111011100111000
  | 9 => 0b000111110011011
  | 10 => 0b110111100100101
  | 11 => 0b011111010010110
  | _ => 0b001001101110111

theorem witness_weight : weight witness = 114 := by decide +kernel

theorem witness_avoids : Avoids34 witness := by
  unfold Avoids34
  decide +kernel

theorem lower_bound : ∃ A : Matrix, Avoids34 A ∧ weight A = 114 :=
  ⟨witness, witness_avoids, witness_weight⟩


/-- The two dimensions are kept separate; rows are 15-bit words. -/
def rowWord (x : BitVec 15) : BitVec 19 := x.cpop.setWidth 4 ++ x

def code (A : Matrix) : BitVec 247 :=
  rowWord (A 0) ++ rowWord (A 1) ++ rowWord (A 2) ++ rowWord (A 3) ++ rowWord (A 4) ++ rowWord (A 5) ++ rowWord (A 6) ++ rowWord (A 7) ++ rowWord (A 8) ++ rowWord (A 9) ++ rowWord (A 10) ++ rowWord (A 11) ++ rowWord (A 12)

def column (A : Matrix) (c : Fin 15) : BitVec 13 :=
  (A 0).extractLsb' c.val 1 ++ (A 1).extractLsb' c.val 1 ++ (A 2).extractLsb' c.val 1 ++ (A 3).extractLsb' c.val 1 ++ (A 4).extractLsb' c.val 1 ++ (A 5).extractLsb' c.val 1 ++ (A 6).extractLsb' c.val 1 ++ (A 7).extractLsb' c.val 1 ++ (A 8).extractLsb' c.val 1 ++ (A 9).extractLsb' c.val 1 ++ (A 10).extractLsb' c.val 1 ++ (A 11).extractLsb' c.val 1 ++ (A 12).extractLsb' c.val 1

def swapIndex (a b x : Fin 13) : Fin 13 :=
  if x = a then b else if x = b then a else x

theorem swapIndex_involutive (a b x : Fin 13) :
    swapIndex a b (swapIndex a b x) = x := by
  by_cases h : a = b
  · subst b
    by_cases hx : x = a
    · subst x; simp [swapIndex]
    · simp [swapIndex, hx]
  · by_cases ha : x = a
    · subst x
      simp [swapIndex, h, Ne.symm h]
    · by_cases hb : x = b
      · subst x
        simp [swapIndex, h, Ne.symm h]
      · simp [swapIndex, ha, hb]

theorem swapIndex_injective (a b : Fin 13) :
    Function.Injective (swapIndex a b) := by
  intro x y h
  have hh := congrArg (swapIndex a b) h
  simpa only [swapIndex_involutive] using hh

def swapRows (A : Matrix) (a b : Fin 13) : Matrix :=
  fun i => A (swapIndex a b i)

theorem swapRows_avoids (A : Matrix) (h : Avoids34 A) (a b : Fin 13) :
    Avoids34 (swapRows A a b) := by
  intro i j k hij hjk hik
  apply h
  · intro he
    exact hij (swapIndex_injective a b he)
  · intro he
    exact hjk (swapIndex_injective a b he)
  · intro he
    exact hik (swapIndex_injective a b he)

def swapAdjacentBits (x : BitVec 15) (c : Fin 14) : BitVec 15 :=
  let lo : BitVec 15 := 1 <<< c.val
  let hi := lo <<< 1
  (x &&& ~~~(lo ||| hi)) ||| ((x &&& lo) <<< 1) ||| ((x &&& hi) >>> 1)

def swapColumns (A : Matrix) (c : Fin 14) : Matrix :=
  fun i => swapAdjacentBits (A i) c

theorem swapAdjacentBits_cpop (x : BitVec 15) (c : Fin 14) :
    (swapAdjacentBits x c).cpop = x.cpop := by
  rcases c with ⟨c, hc⟩
  have hh : c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3 ∨ c = 4 ∨ c = 5 ∨ c = 6 ∨ c = 7 ∨ c = 8 ∨ c = 9 ∨ c = 10 ∨ c = 11 ∨ c = 12 ∨ c = 13 := by omega
  rcases hh with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [swapAdjacentBits] <;> bv_decide

theorem swapAdjacentBits_triple (x y z : BitVec 15) (c : Fin 14) :
    (swapAdjacentBits x c &&& swapAdjacentBits y c &&& swapAdjacentBits z c).cpop =
      (x &&& y &&& z).cpop := by
  rcases c with ⟨c, hc⟩
  have hh : c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3 ∨ c = 4 ∨ c = 5 ∨ c = 6 ∨ c = 7 ∨ c = 8 ∨ c = 9 ∨ c = 10 ∨ c = 11 ∨ c = 12 ∨ c = 13 := by omega
  rcases hh with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [swapAdjacentBits] <;> bv_decide

theorem swapColumns_weight (A : Matrix) (c : Fin 14) :
    weight (swapColumns A c) = weight A := by
  simp only [weight, swapColumns, swapAdjacentBits_cpop]

theorem swapColumns_avoids (A : Matrix) (h : Avoids34 A) (c : Fin 14) :
    Avoids34 (swapColumns A c) := by
  intro i j k hij hjk hik
  simpa only [swapColumns, swapAdjacentBits_triple] using h i j k hij hjk hik

