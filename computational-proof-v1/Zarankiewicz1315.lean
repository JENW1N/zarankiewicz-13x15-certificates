theorem boundedMaximum (P : Nat → Prop) (N : Nat)
    (hne : ∃ n, n ≤ N ∧ P n) :
    ∃ m, m ≤ N ∧ P m ∧ ∀ n, n ≤ N → P n → n ≤ m := by
  classical
  induction N with
  | zero =>
    obtain ⟨n, hn, hp⟩ := hne
    have hn0 : n = 0 := by omega
    subst n
    exact ⟨0, by omega, hp, by intros; omega⟩
  | succ N ih =>
    by_cases hp : P (N + 1)
    · exact ⟨N + 1, by omega, hp, by intros; omega⟩
    · have hex : ∃ n, n ≤ N ∧ P n := by
        obtain ⟨n, hn, hpn⟩ := hne
        refine ⟨n, ?_, hpn⟩
        by_cases hh : n ≤ N
        · exact hh
        · have he : n = N + 1 := by omega
          exact False.elim (hp (he ▸ hpn))
      obtain ⟨m, hm, hpm, hmax⟩ := ih hex
      refine ⟨m, by omega, hpm, ?_⟩
      intro n hn hpn
      have hnN : n ≤ N := by
        by_cases hh : n ≤ N
        · exact hh
        · have he : n = N + 1 := by omega
          exact False.elim (hp (he ▸ hpn))
      exact hmax n hnN hpn

def Counterexample (A : Matrix) : Prop := Avoids33 A ∧ 57 ≤ weight A

theorem counterexample_maximum (hex : ∃ A, Counterexample A) :
    ∃ A, Counterexample A ∧
      ∀ B, Counterexample B → (code B).toNat ≤ (code A).toNat := by
  let P : Nat → Prop := fun n => ∃ A, Counterexample A ∧ (code A).toNat = n
  have hne : ∃ n, n ≤ 2^126 - 1 ∧ P n := by
    obtain ⟨A, hA⟩ := hex
    refine ⟨(code A).toNat, ?_, A, hA, rfl⟩
    have h := (code A).isLt
    omega
  obtain ⟨n, hn, ⟨A, hA, heq⟩, hmax⟩ := boundedMaximum P (2^126 - 1) hne
  refine ⟨A, hA, ?_⟩
  intro B hB
  rw [heq]
  apply hmax
  · have h := (code B).isLt
    omega
  · exact ⟨B, hB, rfl⟩

theorem no_improving_counterexample (A : Matrix)
    (hmax : ∀ B, Counterexample B → (code B).toNat ≤ (code A).toNat)
    (B : Matrix) (hB : Counterexample B) : ¬ code A < code B := by
  intro hlt
  have hm := hmax B hB
  change (code A).toNat < (code B).toNat at hlt
  omega

theorem le_of_not_reverse_lt {w : Nat} (x y : BitVec w) (h : ¬ x < y) : y ≤ x := by
  change ¬ x.toNat < y.toNat at h
  change y.toNat ≤ x.toNat
  omega

