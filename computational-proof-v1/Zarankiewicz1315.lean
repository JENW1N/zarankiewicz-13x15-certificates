def allCases : Option (List Case) := dataLines.mapM parseCase

def verified : Bool :=
  match allCases with
  | none => false
  | some cs => cs.length == 6019 && cs.all checkCase &&
      cs.map (fun c => (c.rows,c.cols)) == expectedPairs


def caseList : List Case := allCases.getD []
def rc (c : Case) := degreeCounts c.rows
def cc (c : Case) := degreeCounts c.cols
def alpha (c : Case) (i : Nat) : Int := c.multipliers[i]!
def beta (c : Case) (j : Nat) : Int := c.multipliers[(rc c).length+j]!
def gamma (c : Case) (i j : Nat) : Int :=
  c.multipliers[(rc c).length+(cc c).length+i*(cc c).length+j]!
def rowCost (c : Case) (t : List Nat) := natDot t ((cc c).map (fun p => choose2 (p.1-1)))
def rowCoeff (c : Case) (i : Nat) (t : List Nat) : Int :=
  alpha c i + intDot t ((List.range (cc c).length).map (gamma c i))
def colCoeff (c : Case) (j : Nat) (u : List Nat) : Int :=
  beta c j - intDot u ((List.range (rc c).length).map (fun i => gamma c i j))
def rhs (c : Case) : Int :=
  intDot ((rc c).map Prod.snd) ((List.range (rc c).length).map (alpha c)) +
  intDot ((cc c).map Prod.snd) ((List.range (cc c).length).map (beta c))

def takeCounts : List Nat → Nat → List Nat
  | [], _ => []
  | x::xs, k => min x k :: takeCounts xs (k-min x k)
def topCounts (u : List Nat) (k : Nat) : List Nat := (takeCounts u.reverse k).reverse
def badChoice (c : Case) (u : List Nat) : List Nat :=
  let ws := (rc c).map (fun p => p.1-1)
  (((List.range (u.sum+1)).map (topCounts u)).find? (fun v => w v.sum < natDot v ws)).getD []
def Bad (c : Case) (u : List Nat) : Prop :=
  let v := badChoice c u
  v.length = u.length ∧ List.Forall₂ (· ≤ ·) v u ∧
    w v.sum < natDot v ((rc c).map (fun p => p.1-1))

instance (c : Case) (u : List Nat) : Decidable (Bad c u) := by unfold Bad; infer_instance

def RowCondition (c : Case) : Prop :=
  ∀ i ∈ List.range (rc c).length,
    ∀ t ∈ distribute ((cc c).map Prod.snd) ((rc c)[i]!).1,
      198 < rowCost c t ∨ 0 ≤ rowCoeff c i t

def ColumnCondition (c : Case) : Prop :=
  ∀ j ∈ List.range (cc c).length,
    ∀ u ∈ distribute ((rc c).map Prod.snd) ((cc c)[j]!).1,
      0 ≤ colCoeff c j u ∨ Bad c u

instance (c : Case) : Decidable (RowCondition c) := by unfold RowCondition; infer_instance
instance (c : Case) : Decidable (ColumnCondition c) := by unfold ColumnCondition; infer_instance

def CountsCondition (xs : List Nat) (ps : List (Nat × Nat)) : Prop :=
  (ps.map Prod.fst).Nodup ∧
  (∀ a ∈ xs, a ∈ ps.map Prod.fst) ∧
  (∀ p ∈ ps, p.2 = xs.count p.1)
instance (xs : List Nat) (ps : List (Nat × Nat)) : Decidable (CountsCondition xs ps) := by
  unfold CountsCondition; infer_instance

def StronglyCertified (c : Case) : Prop :=
  c.rows.length = 13 ∧ c.cols.length = 15 ∧
  (∀ a ∈ c.rows, a ≤ 15) ∧ (∀ d ∈ c.cols, d ≤ 13) ∧
  CountsCondition c.rows (rc c) ∧ CountsCondition c.cols (cc c) ∧
  rhs c < 0 ∧ RowCondition c ∧ ColumnCondition c
instance (c : Case) : Decidable (StronglyCertified c) := by
  unfold StronglyCertified; infer_instance

theorem coverage : caseList.map (fun c => (c.rows,c.cols)) = expectedPairs := by native_decide
theorem strong_certificates : ∀ c ∈ caseList, StronglyCertified c := by native_decide
end Zarankiewicz1315.Certificates

