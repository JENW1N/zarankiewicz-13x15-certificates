  let xs ← (s.splitOn " ").mapM String.toInt?
  if xs.length < 28 || (xs.take 28).any (· < 0) then none
  else some {rows := (xs.take 13).map Int.toNat,
             cols := (xs.drop 13 |>.take 15).map Int.toNat,
             multipliers := (xs.drop 28).toArray}

def degreeCounts (xs : List Nat) : List (Nat × Nat) :=
  ((xs.mergeSort (· ≤ ·)).eraseDups).map (fun d => (d, xs.count d))

def distribute : List Nat → Nat → List (List Nat)
  | [], n => if n = 0 then [[]] else []
  | c :: cs, n => (List.range (min c n + 1)).flatMap fun k =>
      (distribute cs (n-k)).map (k :: ·)

def distributeWeighted : List Nat → List Nat → Nat → Nat → List (List Nat)
  | [], [], n, _ => if n = 0 then [[]] else []
  | c :: cs, w :: ws, n, cap =>
      ((List.range (min c n + 1)).filter (fun k => k*w ≤ cap)).flatMap fun k =>
        (distributeWeighted cs ws (n-k) (cap-k*w)).map (k :: ·)
  | _, _, _, _ => []

def natDot (xs ys : List Nat) : Nat := (xs.zipWith (· * ·) ys).sum

def intDot (xs : List Nat) (ys : List Int) : Int :=
  (xs.zipWith (fun (x : Nat) (y : Int) => (x : Int) * y) ys).sum

def prefixCheck : List Nat → Nat → Nat → Bool
  | [], _, _ => true
  | x :: xs, k, total => total+x ≤ w (k+1) && prefixCheck xs (k+1) (total+x)

def columnAllowed (rd : List Nat) (t : List Nat) : Bool :=
  let weights := (rd.zip t).flatMap fun (a,k) => List.replicate k (a-1)
  prefixCheck (weights.mergeSort (· ≥ ·)) 0 0

def checkCase (c : Case) : Bool := Id.run do
  if c.rows.length != 13 || c.cols.length != 15 then return false
  if c.rows.sum != 115 || c.cols.sum != 115 then return false
  let rc := degreeCounts c.rows
  let cc := degreeCounts c.cols
  let nr := rc.length
  let nc := cc.length
  if c.multipliers.size != nr + nc + nr*nc then return false
  let alphas := c.multipliers.toList.take nr
  let betas := c.multipliers.toList.drop nr |>.take nc
  let rhs := intDot (rc.map Prod.snd) alphas + intDot (cc.map Prod.snd) betas
  if !(rhs < 0) then return false
  for i in [:nr] do
    let degree := (rc[i]!).1
    let gamma := (List.range nc).map fun j => c.multipliers[nr+nc+i*nc+j]!
    for t in distributeWeighted (cc.map Prod.snd)
        (cc.map (fun (d,_) => choose2 (d-1))) degree 198 do
      if natDot t (cc.map (fun (d,_) => choose2 (d-1))) ≤ 198 then
        if c.multipliers[i]! + intDot t gamma < 0 then return false
  for j in [:nc] do
    let degree := (cc[j]!).1
    let gamma := (List.range nr).map fun i => c.multipliers[nr+nc+i*nc+j]!
    for t in distributeWeighted (rc.map Prod.snd)
        (rc.map (fun (a,_) => a-1)) degree (w degree) do
      if columnAllowed (rc.map Prod.fst) t then
        if c.multipliers[nr+j]! - intDot t gamma < 0 then return false
  return true

def columnsVisit : Nat → Nat → Nat → Nat → Nat → List (List Nat)
  | 0, s, _, cost, bound =>
      if s = 0 && cost ≤ 858 && 904 ≤ bound then [[]] else []
  | left+1, s, lo, cost, bound =>
      if s < (left+1)*lo || (left+1)*13 < s || 858 < cost then [] else
      ((List.range 14).filter (fun d => lo ≤ d && d ≤ s/(left+1))).flatMap fun d =>
        (columnsVisit left (s-d) d (cost+choose3 d) (bound+w d)).map (d :: ·)

def rowsVisit : Nat → Nat → Nat → Nat → Nat → List (List Nat)
  | 0, s, _, cost, cap => if s = 0 && cost ≤ cap then [[]] else []
  | left+1, s, lo, cost, cap =>
      if s < (left+1)*lo || (left+1)*15 < s || cap < cost then [] else
      ((List.range 16).filter (fun d => lo ≤ d && d ≤ s/(left+1))).flatMap fun d =>
        (rowsVisit left (s-d) d (cost+d*(d-1)) cap).map (d :: ·)

def expectedPairs : List (List Nat × List Nat) :=
  let rowTable := ((List.range 15).map fun k => rowsVisit 13 115 0 0 (904+k)).toArray
  (columnsVisit 15 115 0 0 0).flatMap fun cs =>
    let cap := (cs.map w).sum
    let rs := if 904 ≤ cap && cap ≤ 918 then rowTable[cap-904]!
              else rowsVisit 13 115 0 0 cap
    rs.map fun r => (r, cs)


