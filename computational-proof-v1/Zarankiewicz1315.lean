def RowSorted (A : Matrix) : Prop :=
  ∀ i : Fin 12, rowWord (A ⟨i.val + 1, by omega⟩) ≤ rowWord (A ⟨i.val, by omega⟩)

def ColumnSorted (A : Matrix) : Prop :=
  ∀ c : Fin 14, column A ⟨c.val, by omega⟩ ≤ column A ⟨c.val + 1, by omega⟩

theorem maximal_is_row_sorted (A : Matrix) (hA : Counterexample A)
    (hm : ∀ B, Counterexample B → (code B).toNat ≤ (code A).toNat) :
    RowSorted A := by
  intro i
  rcases i with ⟨i, hi⟩
  have hs : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 ∨ i = 7 ∨ i = 8 ∨ i = 9 ∨ i = 10 ∨ i = 11 := by omega
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl 
  · exact maximal_rows_0 A hA hm
  · exact maximal_rows_1 A hA hm
  · exact maximal_rows_2 A hA hm
  · exact maximal_rows_3 A hA hm
  · exact maximal_rows_4 A hA hm
  · exact maximal_rows_5 A hA hm
  · exact maximal_rows_6 A hA hm
  · exact maximal_rows_7 A hA hm
  · exact maximal_rows_8 A hA hm
  · exact maximal_rows_9 A hA hm
  · exact maximal_rows_10 A hA hm
  · exact maximal_rows_11 A hA hm

theorem maximal_is_column_sorted (A : Matrix) (hA : Counterexample A)
    (hm : ∀ B, Counterexample B → (code B).toNat ≤ (code A).toNat) :
    ColumnSorted A := by
  intro c
  rcases c with ⟨c, hc⟩
  have hs : c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3 ∨ c = 4 ∨ c = 5 ∨ c = 6 ∨ c = 7 ∨ c = 8 ∨ c = 9 ∨ c = 10 ∨ c = 11 ∨ c = 12 ∨ c = 13 := by omega
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl 
  · exact maximal_columns_0 A hA hm
  · exact maximal_columns_1 A hA hm
  · exact maximal_columns_2 A hA hm
  · exact maximal_columns_3 A hA hm
  · exact maximal_columns_4 A hA hm
  · exact maximal_columns_5 A hA hm
  · exact maximal_columns_6 A hA hm
  · exact maximal_columns_7 A hA hm
  · exact maximal_columns_8 A hA hm
  · exact maximal_columns_9 A hA hm
  · exact maximal_columns_10 A hA hm
  · exact maximal_columns_11 A hA hm
  · exact maximal_columns_12 A hA hm
  · exact maximal_columns_13 A hA hm

theorem sorted_counterexample_exists (h : ∃ A, Counterexample A) :
    ∃ A, Counterexample A ∧ RowSorted A ∧ ColumnSorted A := by
  obtain ⟨A, ha, hm⟩ := counterexample_maximum h
  exact ⟨A, ha, maximal_is_row_sorted A ha hm, maximal_is_column_sorted A ha hm⟩

def IsExtremalValue (n : Nat) : Prop :=
  (∃ A : Matrix, Avoids34 A ∧ weight A = n) ∧
  (∀ A : Matrix, Avoids34 A → weight A ≤ n)

def packedWeight (A : Matrix) : BitVec 15 :=
  (A 0).cpop + (A 1).cpop + (A 2).cpop + (A 3).cpop + (A 4).cpop + (A 5).cpop + (A 6).cpop + (A 7).cpop + (A 8).cpop + (A 9).cpop + (A 10).cpop + (A 11).cpop + (A 12).cpop

theorem packedWeight_toNat (A : Matrix) : (packedWeight A).toNat = weight A := by
  have h0 := BitVec.toNat_cpop_le (A 0)
  have h1 := BitVec.toNat_cpop_le (A 1)
  have h2 := BitVec.toNat_cpop_le (A 2)
  have h3 := BitVec.toNat_cpop_le (A 3)
  have h4 := BitVec.toNat_cpop_le (A 4)
  have h5 := BitVec.toNat_cpop_le (A 5)
  have h6 := BitVec.toNat_cpop_le (A 6)
  have h7 := BitVec.toNat_cpop_le (A 7)
  have h8 := BitVec.toNat_cpop_le (A 8)
  have h9 := BitVec.toNat_cpop_le (A 9)
  have h10 := BitVec.toNat_cpop_le (A 10)
  have h11 := BitVec.toNat_cpop_le (A 11)
  have h12 := BitVec.toNat_cpop_le (A 12)
  simp only [packedWeight, weight, BitVec.toNat_add]
  omega

end Zarankiewicz1315

/- ==================== Basic ==================== -/

set_option maxHeartbeats 0
set_option maxRecDepth 100000

open scoped BigOperators
namespace Full1315

abbrev Grid (m n : Nat) := Fin m → BitVec n

def neighbors {m n} (A : Grid m n) (i : Fin m) : Finset (Fin n) :=
  Finset.univ.filter fun j => (A i).getLsbD j.val = true

def common {m n} (A : Grid m n) (rs : Finset (Fin m)) : Finset (Fin n) :=
  Finset.univ.filter fun j => ∀ i ∈ rs, (A i).getLsbD j.val = true

def avoids {m n} (A : Grid m n) (s t : Nat) : Prop :=
  ∀ rs : Finset (Fin m), rs.card = s → (common A rs).card < t

theorem sum_bits_eq_cpop {n : Nat} (x : BitVec n) :
    (∑ j : Fin n, (x.getLsbD j.val).toNat) = x.cpop.toNat := by
  induction x using BitVec.concat_induction with
  | nil => simp
  | concat x b ih =>
    rw [Fin.sum_univ_succ]
    simpa [BitVec.getLsbD_concat_zero, ih] using congrArg (fun z => b.toNat + z) ih

theorem card_bits_eq_cpop {n : Nat} (x : BitVec n) :
    (Finset.univ.filter fun j : Fin n => x.getLsbD j.val).card = x.cpop.toNat := by
  rw [← sum_bits_eq_cpop]
  simp only [Finset.card_filter]
  congr 1
  funext j
  cases x.getLsbD j.val <;> simp


theorem powerset_neighbors {R C : Type*} [DecidableEq R] [DecidableEq C]
    (E : R → C → Prop) [∀ r c, Decidable (E r c)]
    (rs : Finset R) (c : C) (k : Nat) :
    (rs.filter (fun r => E r c)).powersetCard k =
      (rs.powersetCard k).filter (fun t => ∀ r ∈ t, E r c) := by
  ext t
  simp only [Finset.mem_powersetCard, Finset.mem_filter]
  constructor
  · rintro ⟨ht, hk⟩
    refine ⟨⟨?_, hk⟩, ?_⟩
    · exact fun r hr => (Finset.mem_filter.mp (ht hr)).1
    · exact fun r hr => (Finset.mem_filter.mp (ht hr)).2
  · rintro ⟨⟨ht, hk⟩, he⟩
    exact ⟨fun r hr => Finset.mem_filter.mpr ⟨ht hr, he r hr⟩, hk⟩

theorem incidence_identity {R C : Type*} [DecidableEq R] [DecidableEq C]
    (E : R → C → Prop) [∀ r c, Decidable (E r c)]
    (rs : Finset R) (cs : Finset C) (k : Nat) :
    (∑ c ∈ cs, ((rs.filter (fun r => E r c)).card).choose k) =
      ∑ t ∈ rs.powersetCard k, (cs.filter (fun c => ∀ r ∈ t, E r c)).card := by
  calc
    _ = ∑ c ∈ cs, ((rs.filter (fun r => E r c)).powersetCard k).card := by simp
    _ = ∑ c ∈ cs, ((rs.powersetCard k).filter (fun t => ∀ r ∈ t, E r c)).card := by
      simp only [powerset_neighbors]
    _ = ∑ c ∈ cs, ∑ t ∈ rs.powersetCard k, if (∀ r ∈ t, E r c) then 1 else 0 := by
      simp only [Finset.card_filter]
    _ = ∑ t ∈ rs.powersetCard k, ∑ c ∈ cs, if (∀ r ∈ t, E r c) then 1 else 0 := by
      exact Finset.sum_comm
    _ = _ := by simp only [Finset.card_filter]

theorem incidence_bound {R C : Type*} [DecidableEq R] [DecidableEq C]
    (E : R → C → Prop) [∀ r c, Decidable (E r c)]
    (rs : Finset R) (cs : Finset C) (k L : Nat)
    (h : ∀ t ∈ rs.powersetCard k, (cs.filter (fun c => ∀ r ∈ t, E r c)).card ≤ L) :
    (∑ c ∈ cs, ((rs.filter (fun r => E r c)).card).choose k) ≤ rs.card.choose k * L := by
  rw [incidence_identity]
  calc
    _ ≤ ∑ _t ∈ rs.powersetCard k, L := Finset.sum_le_sum h
    _ = _ := by simp

def colNeighbors {m n} (A : Grid m n) (c : Fin n) : Finset (Fin m) :=
  Finset.univ.filter fun i => (A i).getLsbD c.val = true

def rowDegree {m n} (A : Grid m n) (i : Fin m) : Nat := (neighbors A i).card

def colDegree {m n} (A : Grid m n) (c : Fin n) : Nat := (colNeighbors A c).card

def edges {m n} (A : Grid m n) : Nat := ∑ i, rowDegree A i

theorem rowDegree_eq_cpop {m n} (A : Grid m n) (i : Fin m) :
    rowDegree A i = (A i).cpop.toNat := card_bits_eq_cpop _

theorem colDegree_sum {m n} (A : Grid m n) : (∑ c, colDegree A c) = edges A := by
  simp only [colDegree, colNeighbors, edges, rowDegree, neighbors, Finset.card_filter]
  exact Finset.sum_comm

theorem triple_moment {m n} (A : Grid m n) (h : avoids A 3 4) :
    (∑ c, (colDegree A c).choose 3) ≤ m.choose 3 * 3 := by
  have hh := incidence_bound (fun i c => (A i).getLsbD c.val = true)
    (Finset.univ : Finset (Fin m)) (Finset.univ : Finset (Fin n)) 3 3 (by
      intro t ht
      have hc := h t (Finset.mem_powersetCard.mp ht).2
      have hc' : (common A t).card ≤ 3 := by omega
      convert hc' using 2
      ext c
      simp [common])
  simpa only [colDegree, colNeighbors, Finset.card_univ, Fintype.card_fin] using hh

/-- Eight-element subset bounds control every larger integer-weight neighborhood. -/
theorem eight_subset_bound {R : Type*} [DecidableEq R]
    (s : Finset R) (f : R → Nat) (hs : 8 ≤ s.card)
    (h : ∀ t ⊆ s, t.card = 8 → ∑ i ∈ t, f i ≤ 62) :
    ∑ i ∈ s, f i ≤ 7 * s.card + 6 := by
  let heavy := s.filter (fun i => 8 ≤ f i)
  have hheavy : heavy.card ≤ 7 := by
    by_contra hh
    have hn : 8 ≤ heavy.card := by omega
    obtain ⟨t, ht, hcard⟩ := Finset.exists_subset_card_eq hn
    have hts : t ⊆ s := ht.trans (Finset.filter_subset _ _)
    have hlo : 8 * 8 ≤ ∑ i ∈ t, f i := by
      calc
        _ = ∑ _i ∈ t, 8 := by simp [hcard]
        _ ≤ _ := Finset.sum_le_sum (fun i hi => (Finset.mem_filter.mp (ht hi)).2)
    have hhi := h t hts hcard
    omega
  obtain ⟨t, hht, hts, hcard⟩ :=
    Finset.exists_subsuperset_card_eq (Finset.filter_subset _ _) (by omega : heavy.card ≤ 8) hs
  have hrest : ∑ i ∈ s \ t, f i ≤ 7 * (s \ t).card := by
    calc
      _ ≤ ∑ _i ∈ s \ t, 7 := by
        apply Finset.sum_le_sum
        intro i hi
        obtain ⟨his, hit⟩ := Finset.mem_sdiff.mp hi
        have hh : i ∉ heavy := fun hx => hit (hht hx)
        simp only [heavy, Finset.mem_filter, his, true_and, not_le] at hh
        omega
      _ = _ := by simp [Nat.mul_comm]
  have hsum := Finset.sum_sdiff hts (f := f)
  have hsize := Finset.card_sdiff_add_card_eq_card hts
  have htop := h t hts hcard
  omega


theorem row_triple_budget {m n} (A : Grid m n) (h : avoids A 3 4) (i : Fin m) :
    (∑ c ∈ neighbors A i, (colDegree A c - 1).choose 2) ≤ (m-1).choose 2 * 3 := by
  let rs : Finset (Fin m) := Finset.univ.erase i
  have hdegree (c : Fin n) : (rs.filter (fun r => (A r).getLsbD c.val = true)).card =
      colDegree A c - if (A i).getLsbD c.val = true then 1 else 0 := by
    have he : rs.filter (fun r => (A r).getLsbD c.val = true) = (colNeighbors A c).erase i := by
      ext r
      simp [rs, colNeighbors, and_comm, and_left_comm]
    rw [he]
    by_cases hi : (A i).getLsbD c.val = true
    · have him : i ∈ colNeighbors A c := by simp [colNeighbors, hi]
      simp [colDegree, Finset.card_erase_of_mem him, hi]
    · have him : i ∉ colNeighbors A c := by
        simpa only [colNeighbors, Finset.mem_filter, Finset.mem_univ, true_and] using hi
      rw [Finset.erase_eq_of_notMem him]
      simp only [colDegree, if_neg hi, Nat.sub_zero]
  have hh := incidence_bound (fun r c => (A r).getLsbD c.val = true)
    rs (neighbors A i) 2 3 (by
      intro t ht
      obtain ⟨hsub, hcard⟩ := Finset.mem_powersetCard.mp ht
      have hnot : i ∉ t := fun hit => (Finset.mem_erase.mp (hsub hit)).1 rfl
      have hcard' : (insert i t).card = 3 := by simp [hnot, hcard]
      have hav := h (insert i t) hcard'
      have he : (neighbors A i).filter (fun c => ∀ r ∈ t, (A r).getLsbD c.val = true) =
          common A (insert i t) := by
        ext c
        simp [neighbors, common]
      have hle : (common A (insert i t)).card ≤ 3 := by omega
      convert hle using 2
      ext c
      simp [neighbors, common])
  calc
    _ = ∑ c ∈ neighbors A i, (rs.filter (fun r => (A r).getLsbD c.val = true)).card.choose 2 := by
      apply Finset.sum_congr rfl
      intro c hc
      have hi : (A i).getLsbD c.val = true := (Finset.mem_filter.mp hc).2
      rw [hdegree, if_pos hi]
    _ ≤ rs.card.choose 2 * 3 := hh
    _ = _ := by simp [rs]

theorem row_moment_of_local {m n} (A : Grid m n) (W : Nat → Nat)
    (hl : ∀ c, ∑ i ∈ colNeighbors A c, (rowDegree A i - 1) ≤ W (colDegree A c)) :
    (∑ i, rowDegree A i * (rowDegree A i - 1)) ≤ ∑ c, W (colDegree A c) := by
  have hid : (∑ c, ∑ i ∈ colNeighbors A c, (rowDegree A i - 1)) =
      ∑ i, rowDegree A i * (rowDegree A i - 1) := by
    simp only [colNeighbors, Finset.sum_filter]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    rw [← Finset.sum_filter]
    simp [neighbors, rowDegree]
  rw [← hid]
  exact Finset.sum_le_sum (fun c _ => hl c)


def wordOfFn {n : Nat} (f : Fin n → Bool) : BitVec n :=
  (BitVec.ofBoolListLE (List.ofFn f)).cast (by simp)

theorem bit_wordOfFn {n : Nat} (f : Fin n → Bool) (j : Fin n) :
    (wordOfFn f).getLsbD j.val = f j := by
  simp only [wordOfFn, BitVec.getLsbD_cast, BitVec.getLsbD_ofBoolListLE,
    List.getD_eq_getElem?_getD, List.getElem?_ofFn, dif_pos j.isLt, Option.getD_some]

def subgrid {m n k l} (A : Grid m n) (f : Fin k → Fin m) (g : Fin l → Fin n) : Grid k l :=
  fun i => wordOfFn (fun j => (A (f i)).getLsbD (g j).val)

theorem bit_subgrid {m n k l} (A : Grid m n) (f : Fin k → Fin m) (g : Fin l → Fin n)
    (i : Fin k) (j : Fin l) :
    (subgrid A f g i).getLsbD j.val = (A (f i)).getLsbD (g j).val := by
  exact bit_wordOfFn (fun j => (A (f i)).getLsbD (g j).val) j

noncomputable def enumerateSet {α : Type*} [DecidableEq α]
    (s : Finset α) {n : Nat} (h : s.card = n) : Fin n → α :=
  fun i => ((s.equivFinOfCardEq h).symm i).val

theorem enumerateSet_injective {α : Type*} [DecidableEq α]
    (s : Finset α) {n : Nat} (h : s.card = n) : Function.Injective (enumerateSet s h) := by
  intro i j hij
  apply (s.equivFinOfCardEq h).symm.injective
  exact Subtype.ext hij

theorem enumerateSet_mem {α : Type*} [DecidableEq α]
    (s : Finset α) {n : Nat} (h : s.card = n) (i : Fin n) : enumerateSet s h i ∈ s :=
  ((s.equivFinOfCardEq h).symm i).property

theorem enumerateSet_image {α : Type*} [DecidableEq α]
    (s : Finset α) {n : Nat} (h : s.card = n) : Finset.univ.image (enumerateSet s h) = s := by
  ext x
  simp only [Finset.mem_image, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨i, rfl⟩
    exact enumerateSet_mem s h i
  · intro hx
    refine ⟨(s.equivFinOfCardEq h) ⟨x, hx⟩, ?_⟩
    simp [enumerateSet]

theorem sum_enumerateSet {α M : Type*} [DecidableEq α] [AddCommMonoid M]
    (s : Finset α) {n : Nat} (h : s.card = n) (f : α → M) :
    (∑ i : Fin n, f (enumerateSet s h i)) = ∑ x ∈ s, f x := by
  conv_rhs => rw [← enumerateSet_image s h]
  rw [Finset.sum_image]
  exact fun i _ j _ hij => enumerateSet_injective s h hij

theorem neighbors_subgrid_image {m n k l} (A : Grid m n)
    (f : Fin k → Fin m) (g : Fin l → Fin n) (i : Fin k) :
    (neighbors (subgrid A f g) i).image g =
      (Finset.univ.image g).filter (fun c => (A (f i)).getLsbD c.val = true) := by
  ext c
  simp only [Finset.mem_image, neighbors, Finset.mem_filter, Finset.mem_univ, true_and,
    bit_subgrid]
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j, rfl⟩, hj⟩
  · rintro ⟨⟨j, rfl⟩, hj⟩
    exact ⟨j, hj, rfl⟩

theorem rowDegree_subgrid {m n k l} (A : Grid m n)
    (f : Fin k → Fin m) (g : Fin l → Fin n) (hg : Function.Injective g) (i : Fin k) :
    rowDegree (subgrid A f g) i =
      ((Finset.univ.image g).filter (fun c => (A (f i)).getLsbD c.val = true)).card := by
  rw [← neighbors_subgrid_image]
  exact (Finset.card_image_of_injective _ hg).symm

theorem common_subgrid_image {m n k l} (A : Grid m n)
    (f : Fin k → Fin m) (g : Fin l → Fin n) (t : Finset (Fin k)) :
    (common (subgrid A f g) t).image g =
      (Finset.univ.image g).filter (fun c => ∀ r ∈ t.image f, (A r).getLsbD c.val = true) := by
  ext c
  simp only [Finset.mem_image, common, Finset.mem_filter, Finset.mem_univ, true_and,
    bit_subgrid, Finset.forall_mem_image]
  constructor
  · rintro ⟨j, hj, rfl⟩
    refine ⟨⟨j, rfl⟩, ?_⟩
    intro r hr
    obtain ⟨i, hi, rfl⟩ := hr
    exact hj i hi
  · rintro ⟨⟨j, rfl⟩, hj⟩
    refine ⟨j, ?_, rfl⟩
    intro i hi
    exact hj (f i) ⟨i, hi, rfl⟩

theorem common_card_subgrid {m n k l} (A : Grid m n)
    (f : Fin k → Fin m) (g : Fin l → Fin n) (hg : Function.Injective g) (t : Finset (Fin k)) :
    (common (subgrid A f g) t).card =
      ((Finset.univ.image g).filter (fun c => ∀ r ∈ t.image f, (A r).getLsbD c.val = true)).card := by
  rw [← common_subgrid_image]
  exact (Finset.card_image_of_injective _ hg).symm

theorem edges_subgrid_sets {m n k l} (A : Grid m n)
    (rs : Finset (Fin m)) (cs : Finset (Fin n)) (hr : rs.card = k) (hc : cs.card = l) :
    edges (subgrid A (enumerateSet rs hr) (enumerateSet cs hc)) =
      ∑ i ∈ rs, (cs.filter (fun j => (A i).getLsbD j.val = true)).card := by
  unfold edges
  calc
    _ = ∑ i : Fin k, (cs.filter (fun j => (A (enumerateSet rs hr i)).getLsbD j.val = true)).card := by
      apply Finset.sum_congr rfl
      intro i _
      have hd := rowDegree_subgrid A (enumerateSet rs hr) (enumerateSet cs hc)
        (enumerateSet_injective cs hc) i
      rw [enumerateSet_image] at hd
      exact hd
    _ = _ := sum_enumerateSet (M := Nat) rs hr
      (fun i => (cs.filter (fun j => (A i).getLsbD j.val = true)).card)


def smallW (k : Nat) : Nat :=
  match k with
  | 0 => 0 | 1 => 14 | 2 => 28 | 3 => 30 | 4 => 36 | 5 => 44 | _ => 50

theorem q_bound_four (q : Nat) (h : q ≤ 4) : q ≤ 2 + q.choose 3 := by
  interval_cases q <;> decide

theorem q_bound_six (q : Nat) (h : q ≤ 6) : 3*q ≤ 8 + q.choose 3 := by
  interval_cases q <;> decide

theorem small_incidence_bound {R C : Type*} [DecidableEq R] [DecidableEq C]
    (E : R → C → Prop) [∀ r c, Decidable (E r c)]
    (rs : Finset R) (cs : Finset C) (hr : rs.card ≤ 6) (hc : cs.card = 14)
    (h : ∀ t ∈ rs.powersetCard 3, (cs.filter (fun c => ∀ r ∈ t, E r c)).card ≤ 2) :
    (∑ c ∈ cs, (rs.filter (fun r => E r c)).card) ≤ smallW rs.card := by
  let q := fun c => (rs.filter (fun r => E r c)).card
  have hq (c : C) : q c ≤ rs.card := Finset.card_filter_le _ _
  have hm : (∑ c ∈ cs, (q c).choose 3) ≤ rs.card.choose 3 * 2 := incidence_bound E rs cs 3 2 h
  have ha : (∑ c ∈ cs, q c) ≤ 14 * rs.card := by
    calc
      _ ≤ ∑ _c ∈ cs, rs.card := Finset.sum_le_sum (fun c _ => hq c)
      _ = _ := by simp [hc]
  have hb (hh : rs.card ≤ 4) : (∑ c ∈ cs, q c) ≤ 28 + rs.card.choose 3 * 2 := by
    calc
      _ ≤ ∑ c ∈ cs, (2 + (q c).choose 3) :=
        Finset.sum_le_sum (fun c _ => q_bound_four (q c) ((hq c).trans hh))
      _ = 28 + ∑ c ∈ cs, (q c).choose 3 := by simp [Finset.sum_add_distrib, hc]
      _ ≤ _ := by omega
  have hd : 3*(∑ c ∈ cs, q c) ≤ 112 + rs.card.choose 3 * 2 := by
    calc
      _ = ∑ c ∈ cs, 3*q c := Finset.mul_sum ..
      _ ≤ ∑ c ∈ cs, (8 + (q c).choose 3) :=
        Finset.sum_le_sum (fun c _ => q_bound_six (q c) ((hq c).trans hr))
      _ = 112 + ∑ c ∈ cs, (q c).choose 3 := by simp [Finset.sum_add_distrib, hc]
      _ ≤ _ := by omega
  have hc5 : (5 : Nat).choose 3 = 10 := by decide
  have hc6 : (6 : Nat).choose 3 = 20 := by decide
  change (∑ c ∈ cs, q c) ≤ smallW rs.card
  generalize he : rs.card = k at *
  interval_cases k
  · simpa [smallW] using ha
  · simpa [smallW] using ha
  · simpa [smallW] using ha
  · have hh := hb (by omega)
    norm_num [smallW, hc5, hc6] at *
    omega
  · have hh := hb (by omega)
    norm_num [smallW, hc5, hc6] at *
    omega
  · have hd5 : 3*(∑ c ∈ cs, q c) ≤ 132 := by simpa only [hc5] using hd
    simp only [smallW]
    omega
  · have hd6 : 3*(∑ c ∈ cs, q c) ≤ 152 := by simpa only [hc6] using hd
    simp only [smallW]
    omega

theorem neighborhood_triples {m n} (A : Grid m n) (h : avoids A 3 4)
    (c : Fin n) (s : Finset (Fin m)) (hs : s ⊆ colNeighbors A c)
    (t : Finset (Fin m)) (ht : t ∈ s.powersetCard 3) :
    ((Finset.univ.erase c).filter (fun j => ∀ i ∈ t, (A i).getLsbD j.val = true)).card ≤ 2 := by
  obtain ⟨hts, ht3⟩ := Finset.mem_powersetCard.mp ht
  have hcc : c ∈ common A t := by
    simp only [common, Finset.mem_filter, Finset.mem_univ, true_and]
    intro i hi
    exact (Finset.mem_filter.mp (hs (hts hi))).2
  have he : (Finset.univ.erase c).filter (fun j => ∀ i ∈ t, (A i).getLsbD j.val = true) =
      (common A t).erase c := by
    ext j
    simp [common, and_comm, and_left_comm]
  rw [he, Finset.card_erase_of_mem hcc]
  have hh := h t ht3
  omega

theorem neighborhood_weight {m n} (A : Grid m n) (c : Fin n)
    (s : Finset (Fin m)) (hs : s ⊆ colNeighbors A c) :
    (∑ j ∈ Finset.univ.erase c, (s.filter (fun i => (A i).getLsbD j.val = true)).card) =
      ∑ i ∈ s, (rowDegree A i - 1) := by
  simp only [Finset.card_filter]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  have hic : c ∈ neighbors A i := by
    simpa only [neighbors, colNeighbors, Finset.mem_filter, Finset.mem_univ, true_and] using hs hi
  have he : (Finset.univ.erase c).filter (fun j => (A i).getLsbD j.val = true) =
      (neighbors A i).erase c := by
    ext j
    simp [neighbors, and_comm, and_left_comm]
  rw [← Finset.card_filter, he, Finset.card_erase_of_mem hic]
  rfl

theorem neighborhood_small (A : Grid 13 15) (h : avoids A 3 4)
    (c : Fin 15) (s : Finset (Fin 13)) (hs : s ⊆ colNeighbors A c) (hk : s.card ≤ 6) :
    (∑ i ∈ s, (rowDegree A i - 1)) ≤ smallW s.card := by
  rw [← neighborhood_weight A c s hs]
  apply small_incidence_bound (fun i j => (A i).getLsbD j.val = true) s (Finset.univ.erase c) hk
  · simp
  · intro t ht
    have hh := neighborhood_triples A h c s hs t ht
    convert hh using 2
    ext j
    simp

end Full1315

/- ==================== Small7 ==================== -/
set_option maxRecDepth 200000
set_option maxHeartbeats 0
namespace Small7
abbrev Matrix := Fin 7 → BitVec 14
def weight (A : Matrix) : Nat := (A 0).cpop.toNat + (A 1).cpop.toNat + (A 2).cpop.toNat + (A 3).cpop.toNat + (A 4).cpop.toNat + (A 5).cpop.toNat + (A 6).cpop.toNat
def Avoids33 (A : Matrix) : Prop := ∀ i j k : Fin 7, i ≠ j → j ≠ k → i ≠ k → (A i &&& A j &&& A k).cpop.toNat ≤ 2
def rowWord (x : BitVec 14) : BitVec 18 := x.cpop.setWidth 4 ++ x
def code (A : Matrix) : BitVec 126 := (rowWord (A 0) ++ rowWord (A 1) ++ rowWord (A 2) ++ rowWord (A 3) ++ rowWord (A 4) ++ rowWord (A 5) ++ rowWord (A 6))
def column (A : Matrix) (c : Fin 14) : BitVec 7 := ((A 0).extractLsb' c.val 1 ++ (A 1).extractLsb' c.val 1 ++ (A 2).extractLsb' c.val 1 ++ (A 3).extractLsb' c.val 1 ++ (A 4).extractLsb' c.val 1 ++ (A 5).extractLsb' c.val 1 ++ (A 6).extractLsb' c.val 1)
def swapIndex (a b x : Fin 7) : Fin 7 :=
  if x = a then b else if x = b then a else x

theorem swapIndex_involutive (a b x : Fin 7) :
    swapIndex a b (swapIndex a b x) = x := by
  by_cases h : a = b
  · subst b
