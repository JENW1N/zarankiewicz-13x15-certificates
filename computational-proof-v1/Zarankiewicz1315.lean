/- ==================== AnchorBase ==================== -/

open scoped BigOperators
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

abbrev M13 := Zarankiewicz1315.Matrix

theorem edges13_eq (A : M13) : edges A = Zarankiewicz1315.weight A := by
  simp only [edges, rowDegree_eq_cpop]
  simp [Fin.sum_univ_succ, Zarankiewicz1315.weight]
  <;> omega

theorem avoids13_iff (A : M13) : avoids A 3 4 ↔ Zarankiewicz1315.Avoids34 A := by
  rw [avoids_triples_iff]
  simp only [Zarankiewicz1315.Avoids34, Nat.lt_succ_iff]

def front (i : Fin 8) : Fin 13 := ⟨i.val, by omega⟩
def frontSet : Finset (Fin 13) := Finset.univ.image front

theorem front_injective : Function.Injective front := by
  intro i j h
  apply Fin.ext
  exact congrArg (fun x : Fin 13 => x.val) h

theorem frontSet_card : frontSet.card = 8 := by
  simp [frontSet, Finset.card_image_of_injective _ front_injective]

def baseWeight (A : M13) : Nat := ∑ i : Fin 8, (A (front i)).cpop.toNat

theorem baseWeight_sum (A : M13) : baseWeight A = (A 0).cpop.toNat + (A 1).cpop.toNat + (A 2).cpop.toNat + (A 3).cpop.toNat + (A 4).cpop.toNat + (A 5).cpop.toNat + (A 6).cpop.toNat + (A 7).cpop.toNat := by
  simp [baseWeight, Fin.sum_univ_succ, front]
  <;> omega

theorem baseWeight_frontSet (A : M13) : baseWeight A = ∑ i ∈ frontSet, rowDegree A i := by
  simp only [baseWeight, frontSet, Finset.sum_image, front_injective.injOn, rowDegree_eq_cpop]

def anchored (A : M13) : Prop := ∀ i : Fin 8, (A (front i)).getLsbD 14 = true

theorem anchored_subset (A : M13) (ha : anchored A) : frontSet ⊆ colNeighbors A 14 := by
  intro i hi
  obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hi
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, ha j⟩

theorem baseWeight_decompose (A : M13) (ha : anchored A) :
    baseWeight A = (∑ i ∈ frontSet, (rowDegree A i - 1)) + 8 := by
  rw [baseWeight_frontSet]
  have hlo : ∀ i ∈ frontSet, 1 ≤ rowDegree A i := by
    intro i hi
    have he : 14 ∈ neighbors A i := by
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp (anchored_subset A ha hi)).2⟩
    exact Finset.card_pos.mpr ⟨14, he⟩
  calc
    _ = ∑ i ∈ frontSet, ((rowDegree A i - 1) + 1) := by
      apply Finset.sum_congr rfl
      intro i hi
      have hh := hlo i hi
      omega
    _ = _ := by simp [Finset.sum_add_distrib, frontSet_card]

def AnchorCounterexample (A : M13) : Prop :=
  Zarankiewicz1315.Avoids34 A ∧ 115 ≤ Zarankiewicz1315.weight A ∧
    anchored A ∧ 71 ≤ baseWeight A

theorem anchor_degree_bounds (A : M13) (ha : AnchorCounterexample A) :
    baseWeight A ≤ 72 ∧ ∀ i : Fin 8, baseWeight A ≤ (A (front i)).cpop.toNat + 63 := by
  have hav : avoids A 3 4 := (avoids13_iff A).mpr ha.1
  have hsub := anchored_subset A ha.2.2.1
  let f := fun i => rowDegree A i - 1
  let total := ∑ i ∈ frontSet, f i
  have hb : baseWeight A = total + 8 := by
    exact baseWeight_decompose A ha.2.2.1
  have hseven : ∀ i ∈ frontSet, total ≤ 56 + f i := by
    intro i hi
    have hcard : (frontSet.erase i).card = 7 := by simp [Finset.card_erase_of_mem hi, frontSet_card]
    have hh := neighborhood_seven A hav 14 (frontSet.erase i)
      (Finset.erase_subset _ _ |>.trans hsub) hcard
    have he : (∑ j ∈ frontSet.erase i, f j) + f i = total := Finset.sum_erase_add frontSet f hi
    have hh' : (∑ j ∈ frontSet.erase i, f j) ≤ 56 := hh
    omega
  have hsum : 8 * total ≤ 8 * 56 + total := by
    have h := Finset.sum_le_sum hseven
    simpa [frontSet_card, Finset.sum_add_distrib, total] using h
  have htot : total ≤ 64 := by omega
  constructor
  · omega
  · intro i
    have hi : front i ∈ frontSet := Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
    have hh := hseven (front i) hi
    have hic : 14 ∈ neighbors A (front i) := Finset.mem_filter.mpr
      ⟨Finset.mem_univ _, ha.2.2.1 i⟩
    have hpos : 1 ≤ rowDegree A (front i) := Finset.card_pos.mpr ⟨14, hic⟩
    have hrow := rowDegree_eq_cpop A (front i)
    have hfc : f (front i) + 1 = (A (front i)).cpop.toNat := by
      dsimp [f]
      omega
    omega

theorem property_maximum (P : M13 → Prop) (hne : ∃ A, P A) :
    ∃ A, P A ∧ ∀ B, P B → (Zarankiewicz1315.code B).toNat ≤ (Zarankiewicz1315.code A).toNat := by
  let Q : Nat → Prop := fun n => ∃ A, P A ∧ (Zarankiewicz1315.code A).toNat = n
  have hn : ∃ n, n ≤ 2^247-1 ∧ Q n := by
    obtain ⟨A, ha⟩ := hne
    refine ⟨_, ?_, A, ha, rfl⟩
    have h := (Zarankiewicz1315.code A).isLt
    omega
  obtain ⟨n, hn, ⟨A, ha, he⟩, hm⟩ := Zarankiewicz1315.boundedMaximum Q (2^247-1) hn
  refine ⟨A, ha, ?_⟩
  intro B hb
  rw [he]
  apply hm
  · have h := (Zarankiewicz1315.code B).isLt
    omega
  · exact ⟨B, hb, rfl⟩

theorem max_no_improvement (P : M13 → Prop) (A : M13)
    (hm : ∀ B, P B → (Zarankiewicz1315.code B).toNat ≤ (Zarankiewicz1315.code A).toNat)
    (B : M13) (hb : P B) : ¬ Zarankiewicz1315.code A < Zarankiewicz1315.code B := by
  intro hh
  change (Zarankiewicz1315.code A).toNat < (Zarankiewicz1315.code B).toNat at hh
  have := hm B hb
  omega


theorem swapIndex_front (a b : Fin 13) (h : (a.val < 8 ↔ b.val < 8)) (j : Fin 8) :
    (Zarankiewicz1315.swapIndex a b (front j)).val < 8 := by
  have hj : (front j).val < 8 := j.isLt
  unfold Zarankiewicz1315.swapIndex
  split_ifs with ha hb
  · have hlt : a.val < 8 := ha ▸ hj
    exact h.mp hlt
  · have hlt : b.val < 8 := hb ▸ hj
    exact h.mpr hlt
  · exact hj

theorem swapRows_anchored (A : M13) (ha : anchored A) (a b : Fin 13)
    (h : (a.val < 8 ↔ b.val < 8)) : anchored (Zarankiewicz1315.swapRows A a b) := by
  intro j
  let x := Zarankiewicz1315.swapIndex a b (front j)
  have hx : x.val < 8 := swapIndex_front a b h j
  have he : front ⟨x.val, hx⟩ = x := Fin.ext rfl
  change (A x).getLsbD 14 = true
  simpa only [he] using ha ⟨x.val, hx⟩

theorem low_swap_high_bit (x : BitVec 15) (c : Fin 13) :
    (Zarankiewicz1315.swapAdjacentBits x ⟨c.val, by omega⟩).getLsbD 14 = x.getLsbD 14 := by
  have h : ∀ (x : BitVec 15) (c : Fin 13),
      (Zarankiewicz1315.swapAdjacentBits x ⟨c.val, by omega⟩).getLsbD 14 = x.getLsbD 14 := by
    native_decide
  exact h x c

theorem swapColumns_anchored (A : M13) (ha : anchored A) (c : Fin 13) :
    anchored (Zarankiewicz1315.swapColumns A ⟨c.val, by omega⟩) := by
  intro i
  change (Zarankiewicz1315.swapAdjacentBits (A (front i)) ⟨c.val, by omega⟩).getLsbD 14 = true
  rw [low_swap_high_bit]
  exact ha i

theorem baseWeight_swapColumns (A : M13) (c : Fin 14) :
    baseWeight (Zarankiewicz1315.swapColumns A c) = baseWeight A := by
  simp only [baseWeight, Zarankiewicz1315.swapColumns, Zarankiewicz1315.swapAdjacentBits_cpop]

theorem anchor_swapColumns (A : M13) (ha : AnchorCounterexample A) (c : Fin 13) :
    AnchorCounterexample (Zarankiewicz1315.swapColumns A ⟨c.val, by omega⟩) := by
  refine ⟨Zarankiewicz1315.swapColumns_avoids A ha.1 _, ?_, swapColumns_anchored A ha.2.2.1 c, ?_⟩
  · rw [Zarankiewicz1315.swapColumns_weight]
