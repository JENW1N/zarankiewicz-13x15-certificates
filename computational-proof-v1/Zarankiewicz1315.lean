open scoped BigOperators
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def globalW (d : Nat) : Nat :=
  match d with
  | 0 => 0 | 1 => 14 | 2 => 28 | 3 => 30 | 4 => 36 | 5 => 44
  | 6 => 50 | 7 => 56 | 8 => 62 | 9 => 70 | 10 => 77 | 11 => 84
  | 12 => 91 | 13 => 98 | _ => 0

theorem neighbor_sum_add_card (A : M13) (c : Fin 15) (s : Finset (Fin 13))
    (hs : s ⊆ colNeighbors A c) :
    (∑ i ∈ s, rowDegree A i) = (∑ i ∈ s, (rowDegree A i - 1)) + s.card := by
  calc
    _ = ∑ i ∈ s, ((rowDegree A i - 1) + 1) := by
      apply Finset.sum_congr rfl
      intro i hi
      have hic : c ∈ neighbors A i := by
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp (hs hi)).2⟩
      have hp : 1 ≤ rowDegree A i := Finset.card_pos.mpr ⟨c, hic⟩
      omega
    _ = _ := by simp [Finset.sum_add_distrib]

theorem relabel_for_anchor (A : M13) (c : Fin 15) (s : Finset (Fin 13))
    (hs : s ⊆ colNeighbors A c) (hcard : s.card = 8) :
    ∃ B : M13, (avoids A 3 4 → avoids B 3 4) ∧
      Zarankiewicz1315.weight B = Zarankiewicz1315.weight A ∧
      anchored B ∧ baseWeight B = ∑ i ∈ s, rowDegree A i := by
  classical
  obtain ⟨σ, hσ⟩ := Equiv.Perm.exists_extending_pair front (enumerateSet s hcard)
    front_injective (enumerateSet_injective s hcard)
  let τ : Equiv.Perm (Fin 15) := Equiv.swap 14 c
  let B := colsPerm (rowsPerm A σ) τ
  refine ⟨B, ?_, ?_, ?_, ?_⟩
  · intro ha
    exact avoids_colsPerm _ (avoids_rowsPerm A ha σ) τ
  · rw [← edges13_eq, ← edges13_eq]
    dsimp [B]
    rw [edges_colsPerm, edges_rowsPerm]
  · intro i
    change (colsPerm (rowsPerm A σ) τ (front i)).getLsbD (14 : Fin 15).val = true
    rw [bit_colsPerm, bit_rowsPerm]
    have ht : τ 14 = c := by simp [τ]
    rw [ht, hσ i]
    exact (Finset.mem_filter.mp (hs (enumerateSet_mem s hcard i))).2
  · calc
      baseWeight B = ∑ i : Fin 8, rowDegree B (front i) := by
        simp only [baseWeight, rowDegree_eq_cpop]
      _ = ∑ i : Fin 8, rowDegree A (enumerateSet s hcard i) := by
        apply Finset.sum_congr rfl
        intro i _
        dsimp [B]
        rw [rowDegree_colsPerm, rowDegree_rowsPerm, hσ i]
      _ = _ := sum_enumerateSet s hcard (rowDegree A)

theorem neighborhood_eight (A : M13) (ha : avoids A 3 4)
    (hw : 115 ≤ Zarankiewicz1315.weight A)
    (c : Fin 15) (s : Finset (Fin 13)) (hs : s ⊆ colNeighbors A c) (hcard : s.card = 8) :
    (∑ i ∈ s, (rowDegree A i - 1)) ≤ 62 := by
  by_contra hh
  have hlo : 63 ≤ ∑ i ∈ s, (rowDegree A i - 1) := by omega
  have hsum := neighbor_sum_add_card A c s hs
  obtain ⟨B, hB, hweight, hanchor, hbase⟩ := relabel_for_anchor A c s hs hcard
  apply anchor_impossible
  refine ⟨B, (avoids13_iff B).mp (hB ha), ?_, hanchor, ?_⟩
  · rw [hweight]
    exact hw
  · rw [hbase]
    omega

theorem smallW_eq_globalW (k : Nat) (h : k ≤ 6) : smallW k = globalW k := by
  interval_cases k <;> rfl

theorem large_globalW (k : Nat) (hlo : 8 ≤ k) (hhi : k ≤ 13) : 7*k+6 ≤ globalW k := by
  interval_cases k <;> decide

theorem neighborhood_bound (A : M13) (ha : avoids A 3 4)
    (hw : 115 ≤ Zarankiewicz1315.weight A)
    (c : Fin 15) (s : Finset (Fin 13)) (hs : s ⊆ colNeighbors A c) :
    (∑ i ∈ s, (rowDegree A i - 1)) ≤ globalW s.card := by
  have hcard : s.card ≤ 13 := by simpa using Finset.card_le_univ s
  by_cases hsmall : s.card ≤ 6
  · rw [← smallW_eq_globalW s.card hsmall]
    exact neighborhood_small A ha c s hs hsmall
  · by_cases hseven : s.card = 7
    · simpa only [hseven, globalW] using neighborhood_seven A ha c s hs hseven
    · have hlarge : 8 ≤ s.card := by omega
      have h := eight_subset_bound s (fun i => rowDegree A i - 1) hlarge (by
        intro t hts ht
        exact neighborhood_eight A ha hw c t (hts.trans hs) ht)
      exact h.trans (large_globalW s.card hlarge hcard)

theorem global_row_moment (A : M13) (ha : avoids A 3 4)
    (hw : 115 ≤ Zarankiewicz1315.weight A) :
    (∑ i, rowDegree A i * (rowDegree A i - 1)) ≤ ∑ c, globalW (colDegree A c) := by
  apply row_moment_of_local
  intro c
  exact neighborhood_bound A ha hw c (colNeighbors A c) (Finset.Subset.refl _)

end Full1315

