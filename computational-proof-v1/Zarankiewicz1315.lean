/- ==================== Permutations ==================== -/

open scoped BigOperators
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def rowsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin m)) : Grid m n := fun i => A (s i)
def colsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin n)) : Grid m n := subgrid A id s

theorem bit_rowsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin m)) (i : Fin m) (j : Fin n) :
    (rowsPerm A s i).getLsbD j.val = (A (s i)).getLsbD j.val := rfl

theorem bit_colsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin n)) (i : Fin m) (j : Fin n) :
    (colsPerm A s i).getLsbD j.val = (A i).getLsbD (s j).val := bit_subgrid A id s i j

theorem common_rowsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin m)) (t : Finset (Fin m)) :
    common (rowsPerm A s) t = common A (t.image s) := by
  ext c
  simp [common, rowsPerm]

theorem rowDegree_rowsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin m)) (i : Fin m) :
    rowDegree (rowsPerm A s) i = rowDegree A (s i) := rfl

theorem edges_rowsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin m)) :
    edges (rowsPerm A s) = edges A := by
  simp only [edges, rowDegree_rowsPerm]
  exact Equiv.sum_comp s (rowDegree A)

theorem avoids_rowsPerm {m n} (A : Grid m n) (h : avoids A a b) (s : Equiv.Perm (Fin m)) :
    avoids (rowsPerm A s) a b := by
  intro t ht
  rw [common_rowsPerm]
  apply h
  simpa only [Finset.card_image_of_injective _ s.injective] using ht

theorem perm_image_univ {n} (s : Equiv.Perm (Fin n)) :
    Finset.univ.image s = (Finset.univ : Finset (Fin n)) := by
  ext c
  simp only [Finset.mem_image, Finset.mem_univ, true_and, iff_true]
  exact ⟨s.symm c, s.apply_symm_apply c⟩

theorem rowDegree_colsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin n)) (i : Fin m) :
    rowDegree (colsPerm A s) i = rowDegree A i := by
  have hh := rowDegree_subgrid A id s s.injective i
  rw [perm_image_univ] at hh
  exact hh

theorem common_card_colsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin n)) (t : Finset (Fin m)) :
    (common (colsPerm A s) t).card = (common A t).card := by
  unfold colsPerm
  rw [common_card_subgrid A id s s.injective t]
  apply congrArg Finset.card
  ext c
  simp [perm_image_univ, common]

theorem edges_colsPerm {m n} (A : Grid m n) (s : Equiv.Perm (Fin n)) :
    edges (colsPerm A s) = edges A := by
  simp only [edges, rowDegree_colsPerm]

theorem avoids_colsPerm {m n} (A : Grid m n) (h : avoids A a b) (s : Equiv.Perm (Fin n)) :
    avoids (colsPerm A s) a b := by
  intro t ht
  rw [common_card_colsPerm]
  exact h t ht

end Full1315

