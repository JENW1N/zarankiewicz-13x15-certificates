def GroupSorted (A : M13) : Prop := ∀ i : Fin 12, i.val ≠ 7 →
  Zarankiewicz1315.rowWord (A ⟨i.val+1, by omega⟩) ≤ Zarankiewicz1315.rowWord (A ⟨i.val, by omega⟩)
def LowColumnsSorted (A : M13) : Prop := ∀ c : Fin 13,
  Zarankiewicz1315.column A ⟨c.val, by omega⟩ ≤ Zarankiewicz1315.column A ⟨c.val+1, by omega⟩

theorem anchor_sorted_exists (h : ∃ A, AnchorCounterexample A) :
    ∃ A, AnchorCounterexample A ∧ GroupSorted A ∧ LowColumnsSorted A := by
  obtain ⟨A, ha, hm⟩ := property_maximum AnchorCounterexample h
  refine ⟨A, ha, ?_, ?_⟩
  · intro i hi
    fin_cases i
    · exact anchor_max_row_0 A ha hm
    · exact anchor_max_row_1 A ha hm
    · exact anchor_max_row_2 A ha hm
    · exact anchor_max_row_3 A ha hm
    · exact anchor_max_row_4 A ha hm
    · exact anchor_max_row_5 A ha hm
    · exact anchor_max_row_6 A ha hm
    · exact False.elim (hi rfl)
    · exact anchor_max_row_8 A ha hm
    · exact anchor_max_row_9 A ha hm
    · exact anchor_max_row_10 A ha hm
    · exact anchor_max_row_11 A ha hm
  · intro c
    fin_cases c
    · exact anchor_max_col_0 A ha hm
    · exact anchor_max_col_1 A ha hm
    · exact anchor_max_col_2 A ha hm
    · exact anchor_max_col_3 A ha hm
    · exact anchor_max_col_4 A ha hm
    · exact anchor_max_col_5 A ha hm
    · exact anchor_max_col_6 A ha hm
    · exact anchor_max_col_7 A ha hm
    · exact anchor_max_col_8 A ha hm
    · exact anchor_max_col_9 A ha hm
    · exact anchor_max_col_10 A ha hm
    · exact anchor_max_col_11 A ha hm
    · exact anchor_max_col_12 A ha hm

theorem rowWord_nat (x : BitVec 15) :
    (Zarankiewicz1315.rowWord x).toNat = x.cpop.toNat * 32768 + x.toNat := by
  have hc := BitVec.toNat_cpop_le x
  simp only [Zarankiewicz1315.rowWord,BitVec.toNat_append,BitVec.toNat_setWidth]
  rw [Nat.mod_eq_of_lt (by omega : x.cpop.toNat < 2^4)]
  rw [← Nat.shiftLeft_add_eq_or_of_lt x.isLt, Nat.shiftLeft_eq]

theorem rowWord_degree (x y : BitVec 15)
    (h : Zarankiewicz1315.rowWord x ≤ Zarankiewicz1315.rowWord y) : x.cpop ≤ y.cpop := by
  rw [BitVec.le_def,rowWord_nat,rowWord_nat] at h
  rw [BitVec.le_def]
  have hx := x.isLt
  have hy := y.isLt
  omega

theorem rowWord_value (x y : BitVec 15)
    (h : Zarankiewicz1315.rowWord x ≤ Zarankiewicz1315.rowWord y)
    (hd : x.cpop = y.cpop) : x ≤ y := by
  rw [BitVec.le_def,rowWord_nat,rowWord_nat,hd] at h
  rw [BitVec.le_def]
  omega

theorem dense_common_iff (x : BitVec 15) :
    DenseOracle.boundedCommon x = true ↔ x.cpop ≤ (3 : BitVec 15) := by
  have h : ∀ x : BitVec 15,
      DenseOracle.boundedCommon x = true ↔ x.cpop ≤ (3 : BitVec 15) := by
    native_decide
  exact h x



