theorem common_three_card {m n} (A : Grid m n) (i j k : Fin m) :
    (common A {i,j,k}).card = (A i &&& A j &&& A k).cpop.toNat := by
  have he : common A {i,j,k} =
      Finset.univ.filter (fun c : Fin n => (A i &&& A j &&& A k).getLsbD c.val = true) := by
    ext c
    simp [common, BitVec.getLsbD_and, Bool.and_eq_true, and_assoc]
  rw [he]
  exact card_bits_eq_cpop _

theorem avoids_triples_iff {m n} (A : Grid m n) (t : Nat) :
    avoids A 3 t ↔ ∀ i j k : Fin m, i ≠ j → j ≠ k → i ≠ k →
      (A i &&& A j &&& A k).cpop.toNat < t := by
  constructor
  · intro h i j k hij hjk hik
    rw [← common_three_card]
    apply h
    simp [hij, hjk, hik]
  · intro h s hs
    obtain ⟨i,j,k,hij,hik,hjk,rfl⟩ := Finset.card_eq_three.mp hs
    rw [common_three_card]
    exact h i j k hij hjk hik

theorem edges7_eq (B : Grid 7 14) : edges B = Small7.weight B := by
  simp only [edges, rowDegree_eq_cpop]
  simp [Fin.sum_univ_succ, Small7.weight]
  <;> omega

theorem seven_bound (B : Grid 7 14) (h : avoids B 3 3) : edges B ≤ 56 := by
  have ht : Small7.Avoids33 B := by
    intro i j k hij hjk hik
    have hh := (avoids_triples_iff B 3).mp h i j k hij hjk hik
    omega
  rw [edges7_eq]
  exact Small7.upper_bound B ht

theorem subgrid_avoids_of {m n k l} (A : Grid m n)
    (f : Fin k → Fin m) (g : Fin l → Fin n)
    (hf : Function.Injective f) (hg : Function.Injective g) (s t : Nat)
    (h : ∀ u ∈ (Finset.univ.image f).powersetCard s,
      ((Finset.univ.image g).filter (fun c => ∀ i ∈ u, (A i).getLsbD c.val = true)).card < t) :
    avoids (subgrid A f g) s t := by
  intro u hu
  rw [common_card_subgrid A f g hg]
  apply h
  apply Finset.mem_powersetCard.mpr
  constructor
  · exact Finset.image_subset_image (Finset.subset_univ u)
  · simpa [Finset.card_image_of_injective u hf] using hu

theorem neighborhood_subgrid_avoids (A : Grid 13 15) (h : avoids A 3 4)
    (c : Fin 15) (s : Finset (Fin 13)) (k : Nat)
    (hs : s ⊆ colNeighbors A c) (hk : s.card = k) :
    avoids (subgrid A (enumerateSet s hk)
      (enumerateSet (Finset.univ.erase c) (by simp : (Finset.univ.erase c).card = 14))) 3 3 := by
  apply subgrid_avoids_of A _ _ (enumerateSet_injective s hk)
    (enumerateSet_injective (Finset.univ.erase c) (by simp))
  intro u hu
  rw [enumerateSet_image] at hu
  have hh := neighborhood_triples A h c s hs u hu
  have hh' : ((Finset.univ.erase c).filter (fun j => ∀ i ∈ u, (A i).getLsbD j.val = true)).card < 3 := by omega
  simpa only [enumerateSet_image] using hh'

theorem edges_neighborhood_subgrid (A : Grid 13 15) (c : Fin 15)
    (s : Finset (Fin 13)) (k : Nat) (hs : s ⊆ colNeighbors A c) (hk : s.card = k) :
    edges (subgrid A (enumerateSet s hk)
      (enumerateSet (Finset.univ.erase c) (by simp : (Finset.univ.erase c).card = 14))) =
      ∑ i ∈ s, (rowDegree A i - 1) := by
  rw [edges_subgrid_sets]
  apply Finset.sum_congr rfl
  intro i hi
  have hic : c ∈ neighbors A i := by
    simpa only [neighbors, colNeighbors, Finset.mem_filter, Finset.mem_univ, true_and] using hs hi
  have he : (Finset.univ.erase c).filter (fun j => (A i).getLsbD j.val = true) =
      (neighbors A i).erase c := by
    ext j
    simp [neighbors, and_comm]
  rw [he, Finset.card_erase_of_mem hic]
  rfl

theorem neighborhood_seven (A : Grid 13 15) (h : avoids A 3 4)
    (c : Fin 15) (s : Finset (Fin 13)) (hs : s ⊆ colNeighbors A c) (hk : s.card = 7) :
    (∑ i ∈ s, (rowDegree A i - 1)) ≤ 56 := by
  let B := subgrid A (enumerateSet s hk)
    (enumerateSet (Finset.univ.erase c) (by simp : (Finset.univ.erase c).card = 14))
  have hb : avoids B 3 3 := neighborhood_subgrid_avoids A h c s 7 hs hk
  have he := edges_neighborhood_subgrid A c s 7 hs hk
  rw [← he]
  exact seven_bound B hb

