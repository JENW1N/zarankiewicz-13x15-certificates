open scoped BigOperators
open Zarankiewicz1315.Certificates
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

@[simp] theorem range_map_ofFn {β : Type*} (n : Nat) (f : Nat → β) :
    (List.range n).map f = List.ofFn (fun i : Fin n => f i.val) := by
  apply List.ext_getElem
  · simp
  · intro i hi hj
    simp

@[simp] theorem zipWith_ofFn {α β γ : Type*} {n : Nat} (op : α → β → γ)
    (f : Fin n → α) (g : Fin n → β) :
    (List.ofFn f).zipWith op (List.ofFn g) = List.ofFn (fun i => op (f i) (g i)) := by
  apply List.ext_getElem
  · simp
  · intro i hi hj
    simp

@[simp] theorem natDot_ofFn {n : Nat} (f g : Fin n → Nat) :
    natDot (List.ofFn f) (List.ofFn g) = ∑ i, f i * g i := by
  simp [natDot, List.sum_ofFn]

@[simp] theorem intDot_ofFn {n : Nat} (f : Fin n → Nat) (g : Fin n → Int) :
    intDot (List.ofFn f) (List.ofFn g) = ∑ i, (f i : Int) * g i := by
  simp [intDot, List.sum_ofFn]

@[simp] theorem getBang_eq_get {α : Type*} [Inhabited α] (ps : List α) (i : Fin ps.length) :
    ps[i.val]! = ps[i.val] := by
  exact getElem!_pos ps i.val i.isLt

theorem forall2_ofFn {α β : Type*} {n : Nat} (R : α → β → Prop)
    (f : Fin n → α) (g : Fin n → β) (h : ∀ i, R (f i) (g i)) :
    List.Forall₂ R (List.ofFn f) (List.ofFn g) := by
  apply List.forall₂_of_length_eq_of_get (by simp)
  intro i hi hj
  simpa using h ⟨i, by simpa using hi⟩

theorem ofFn_count {n : Nat} (f : Fin n → Nat) (a : Nat) :
    (List.ofFn f).count a = (Finset.univ.filter (fun i => f i = a)).card := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [List.ofFn_succ, List.count_cons, Finset.card_filter]
    rw [Fin.sum_univ_succ]
    have ht := ih (fun i => f i.succ)
    rw [Finset.card_filter] at ht
    rw [ht]
    by_cases h : f 0 = a <;> simp [h, beq_iff_eq, Nat.add_comm]

def classLabel (ps : List (Nat × Nat)) (i : Fin ps.length) : Nat := ps[i.val].1
def classSize (ps : List (Nat × Nat)) (i : Fin ps.length) : Nat := ps[i.val].2

structure DegreeClasses {n : Nat} (D : Fin n → Nat) (ps : List (Nat × Nat)) where
  index : Fin n → Fin ps.length
  label_eq : ∀ v, classLabel ps (index v) = D v
  size_eq : ∀ i, (Finset.univ.filter (fun v => index v = i)).card = classSize ps i

noncomputable def degreeClasses {n : Nat} (D : Fin n → Nat) (xs : List Nat)
    (ps : List (Nat × Nat)) (hp : xs.Perm (List.ofFn D))
    (hc : CountsCondition xs ps) : DegreeClasses D ps := by
  classical
  have hmem (v : Fin n) : D v ∈ ps.map Prod.fst :=
    hc.2.1 (D v) (hp.mem_iff.mpr (List.mem_ofFn.mpr ⟨v,rfl⟩))
  have hex (v : Fin n) : ∃ i : Fin ps.length, classLabel ps i = D v := by
    obtain ⟨k,hk,he⟩ := List.mem_iff_getElem.mp (hmem v)
    exact ⟨⟨k, by simpa using hk⟩, by simpa [classLabel] using he⟩
  let idx := fun v => Classical.choose (hex v)
  have hl (v) : classLabel ps (idx v) = D v := Classical.choose_spec (hex v)
  have hinj : Function.Injective (classLabel ps) := by
    intro i j hij
    apply Fin.ext
    have hh := (List.nodup_iff_injective_get.mp hc.1)
    have hv : (ps.map Prod.fst).get ⟨i.val, by simp⟩ =
        (ps.map Prod.fst).get ⟨j.val, by simp⟩ := by simpa [classLabel] using hij
    exact congrArg (fun k => k.val) (hh hv)
  refine ⟨idx, hl, ?_⟩
  intro i
  have hf : (Finset.univ.filter (fun v => idx v = i)) =
      Finset.univ.filter (fun v => D v = classLabel ps i) := by
    ext v
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · intro hh
      simpa [hh] using (hl v).symm
    · intro hh
      apply hinj
      exact (hl v).trans hh
  rw [hf, ← ofFn_count, ← hp.count_eq]
  exact (hc.2.2 (ps[i.val]) (List.getElem_mem i.isLt)).symm

theorem sum_by_class {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) (f : Fin ps.length → Nat) :
    (∑ v ∈ s, f (C.index v)) =
      ∑ i, (s.filter (fun v => C.index v = i)).card * f i := by
  rw [← Finset.sum_fiberwise s C.index]
  apply Finset.sum_congr rfl
  intro i _
  calc
    _ = ∑ _v ∈ s.filter (fun v => C.index v = i), f i := by
      apply Finset.sum_congr rfl
      intro v hv
      rw [(Finset.mem_filter.mp hv).2]
    _ = _ := by simp [Nat.mul_comm]

theorem sum_by_class_int {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) (f : Fin ps.length → Int) :
    (∑ v ∈ s, f (C.index v)) =
      ∑ i, ((s.filter (fun v => C.index v = i)).card : Int) * f i := by
  rw [← Finset.sum_fiberwise s C.index]
  apply Finset.sum_congr rfl
  intro i _
  calc
    _ = ∑ _v ∈ s.filter (fun v => C.index v = i), f i := by
      apply Finset.sum_congr rfl
      intro v hv
      rw [(Finset.mem_filter.mp hv).2]
    _ = _ := by simp [mul_comm]

end Full1315

