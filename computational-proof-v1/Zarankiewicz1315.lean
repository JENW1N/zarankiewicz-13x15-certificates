open scoped BigOperators
open Zarankiewicz1315.Certificates
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

theorem cachedRows_eq (cap : Nat) (hlo : 904 ≤ cap) (hhi : cap ≤ 918) :
    (((List.range 15).map fun k => rowsVisit 13 115 0 0 (904+k)).toArray)[cap-904]! =
      rowsVisit 13 115 0 0 cap := by
  have hi : cap - 904 < 15 := by omega
  have hadd : 904 + (cap - 904) = cap := by omega
  rw [getElem!_pos _ _ (by simpa using hi)]
  simp only [List.getElem_toArray, List.getElem_map, List.getElem_range, hadd]

theorem expectedPairs_complete (rs cs : List Nat)
    (hrl : rs.length = 13) (hcl : cs.length = 15)
    (hrs : rs.sum = 115) (hcs : cs.sum = 115)
    (hrp : rs.Pairwise (· ≤ ·)) (hcp : cs.Pairwise (· ≤ ·))
    (hrb : ∀ a ∈ rs, a ≤ 15) (hcb : ∀ d ∈ cs, d ≤ 13)
    (htriple : (cs.map choose3).sum ≤ 858)
    (hrow : (rs.map (fun a => a*(a-1))).sum ≤ (cs.map w).sum)
    (hmin : 904 ≤ (cs.map w).sum) :
    (rs,cs) ∈ expectedPairs := by
  have hcols := mem_columnsVisit cs 0 0 0 hcp (by
    intro d hd
    exact ⟨Nat.zero_le _, hcb d hd⟩) (by simpa using htriple) (by simpa using hmin)
  rw [hcl, hcs] at hcols
  have hrows := mem_rowsVisit rs 0 0 ((cs.map w).sum) hrp (by
    intro a ha
    exact ⟨Nat.zero_le _, hrb a ha⟩) (by simpa using hrow)
  rw [hrl, hrs] at hrows
  unfold expectedPairs
  apply List.mem_flatMap.mpr
  refine ⟨cs,hcols,?_⟩
  apply List.mem_map.mpr
  refine ⟨rs,?_,rfl⟩
  split_ifs with h
  · have hh : 904 ≤ (cs.map w).sum ∧ (cs.map w).sum ≤ 918 := by
      simpa only [Bool.and_eq_true,decide_eq_true_eq] using h
    rw [cachedRows_eq _ hh.1 hh.2]
    exact hrows
  · exact hrows

theorem certificate_of_profiles (rs cs : List Nat) (h : (rs,cs) ∈ expectedPairs) :
    ∃ c : Case, StronglyCertified c ∧ c.rows = rs ∧ c.cols = cs := by
  rw [← coverage] at h
  obtain ⟨c,hc,he⟩ := List.mem_map.mp h
  exact ⟨c,strong_certificates c hc,congrArg Prod.fst he,congrArg Prod.snd he⟩

end Full1315

/- ==================== Signatures ==================== -/

open scoped BigOperators
open Zarankiewicz1315.Certificates
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

@[simp] theorem sizes_as_ofFn (ps : List (Nat × Nat)) :
    ps.map Prod.snd = List.ofFn (classSize ps) := by
  symm
  exact List.ofFn_getElem_eq_map ps Prod.snd

@[simp] theorem labels_as_ofFn (ps : List (Nat × Nat)) (f : Nat → Nat) :
    ps.map (fun p => f p.1) = List.ofFn (fun i => f (classLabel ps i)) := by
  symm
  exact List.ofFn_getElem_eq_map ps (fun p => f p.1)

def signature {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) : List Nat :=
  List.ofFn (fun i => (s.filter (fun v => C.index v = i)).card)

theorem signature_sum {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) : (signature C s).sum = s.card := by
  have hh := sum_by_class C s (fun _ => 1)
  simpa [signature, List.sum_ofFn] using hh.symm

theorem signature_le {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) :
    List.Forall₂ (· ≤ ·) (signature C s) (ps.map Prod.snd) := by
  rw [sizes_as_ofFn]
  apply forall2_ofFn
  intro i
  rw [← C.size_eq]
  apply Finset.card_le_card
  intro v hv
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,(Finset.mem_filter.mp hv).2⟩

theorem signature_distribute {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) :
    signature C s ∈ distribute (ps.map Prod.snd) s.card :=
  mem_distribute _ _ (signature_sum C s) (signature_le C s)

theorem signature_natDot {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) (f : Nat → Nat) :
    natDot (signature C s) (ps.map (fun p => f p.1)) = ∑ v ∈ s, f (D v) := by
  rw [labels_as_ofFn]
  simp only [signature, natDot_ofFn]
  rw [← sum_by_class]
  apply Finset.sum_congr rfl
  intro v _
  rw [C.label_eq]

theorem signature_intDot {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) (f : Nat → Int) :
    intDot (signature C s) ((List.range ps.length).map f) =
      ∑ v ∈ s, f (C.index v).val := by
  rw [range_map_ofFn]
  simp only [signature, intDot_ofFn]
  exact (sum_by_class_int C s (fun i => f i.val)).symm

theorem select_signature {n k : Nat} (idx : Fin n → Fin k) (s : Finset (Fin n))
    (v : Fin k → Nat) (hv : ∀ i, v i ≤ (s.filter (fun x => idx x = i)).card) :
    ∃ t : Finset (Fin n), t ⊆ s ∧ ∀ i, (t.filter (fun x => idx x = i)).card = v i := by
  classical
  have he (i) := Finset.exists_subset_card_eq (hv i)
  choose sets hs hc using he
  let t := Finset.univ.biUnion sets
  have hsub : t ⊆ s := by
    intro x hx
    obtain ⟨i,_,hxi⟩ := Finset.mem_biUnion.mp hx
    exact (Finset.mem_filter.mp (hs i hxi)).1
  refine ⟨t,hsub,?_⟩
  intro i
  have hf : t.filter (fun x => idx x = i) = sets i := by
    ext x
    constructor
    · intro hx
      obtain ⟨hx,hi⟩ := Finset.mem_filter.mp hx
      obtain ⟨j,_,hj⟩ := Finset.mem_biUnion.mp hx
      have hj' := (Finset.mem_filter.mp (hs j hj)).2
      have hij : i = j := hi.symm.trans hj'
      simpa [hij] using hj
    · intro hx
      exact Finset.mem_filter.mpr ⟨Finset.mem_biUnion.mpr ⟨i,Finset.mem_univ _,hx⟩,
        (Finset.mem_filter.mp (hs i hx)).2⟩
  rw [hf, hc]

theorem realize_subsignature {n : Nat} {D : Fin n → Nat} {ps : List (Nat × Nat)}
    (C : DegreeClasses D ps) (s : Finset (Fin n)) (v : List Nat)
    (hl : v.length = (signature C s).length)
    (hv : List.Forall₂ (· ≤ ·) v (signature C s)) :
    ∃ t : Finset (Fin n), t ⊆ s ∧ t.card = v.sum ∧
      (∑ x ∈ t, (D x - 1)) = natDot v (ps.map (fun p => p.1-1)) := by
  have hlen : v.length = ps.length := by simpa [signature] using hl
  let vf : Fin ps.length → Nat := fun i => v[i.val]'(by omega)
  have hvf : v = List.ofFn vf := by
    apply List.ext_getElem
    · simpa using hlen
    · intro i hi hj
      simp [vf]
  have hbound (i : Fin ps.length) : vf i ≤ (s.filter (fun x => C.index x = i)).card := by
    have hh := hv.get (by omega : i.val < v.length)
      (by simpa [signature] using i.isLt)
    simpa [vf, signature] using hh
  obtain ⟨t,ht,heq⟩ := select_signature C.index s vf hbound
  have hsig : signature C t = v := by
    rw [hvf]
    unfold signature
    congr 1
    funext i
    exact heq i
  refine ⟨t,ht,?_,?_⟩
  · rw [← signature_sum C t, hsig]
  · rw [← signature_natDot C t (fun d => d-1),hsig]

end Full1315

/- ==================== ApplyCert ==================== -/

open scoped BigOperators
open Zarankiewicz1315.Certificates
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

theorem choose2_small (d : Nat) (hd : d ≤ 13) : choose2 (d-1) = (d-1).choose 2 := by
  interval_cases d <;> decide

theorem certificate_contradiction (A : Grid 13 15) (ha : avoids A 3 4)
    (hlocal : ∀ d : Fin 15, ∀ s : Finset (Fin 13), s ⊆ colNeighbors A d →
      (∑ v ∈ s, (rowDegree A v - 1)) ≤ w s.card)
    (c : Case) (hcert : StronglyCertified c)
    (hrperm : c.rows.Perm (List.ofFn (rowDegree A)))
    (hcperm : c.cols.Perm (List.ofFn (colDegree A))) : False := by
  classical
  obtain ⟨_,_,_,_,hcr,hcc,hneg,hrow,hcol⟩ := hcert
  let R := degreeClasses (rowDegree A) c.rows (rc c) hrperm hcr
  let C := degreeClasses (colDegree A) c.cols (cc c) hcperm hcc
  let rv (v : Fin 13) : Int := alpha c (R.index v).val +
    ∑ d ∈ neighbors A v, gamma c (R.index v).val (C.index d).val
  let cv (d : Fin 15) : Int := beta c (C.index d).val -
    ∑ v ∈ colNeighbors A d, gamma c (R.index v).val (C.index d).val
  have hrv (v : Fin 13) : 0 ≤ rv v := by
    have hm := signature_distribute C (neighbors A v)
    have hd : ((rc c)[(R.index v).val]!).1 = rowDegree A v := by
      rw [getBang_eq_get]
      exact R.label_eq v
    have hcond := hrow (R.index v).val (by simp)
      (signature C (neighbors A v)) (by simpa only [hd, rowDegree] using hm)
    have hcost : rowCost c (signature C (neighbors A v)) ≤ 198 := by
      calc
        _ = ∑ d ∈ neighbors A v, (colDegree A d - 1).choose 2 := by
          rw [rowCost, signature_natDot C (neighbors A v) (fun a => choose2 (a-1))]
          apply Finset.sum_congr rfl
          intro d _
          apply choose2_small
          exact Finset.card_le_univ (colNeighbors A d)
        _ ≤ 198 := by
          have hh := row_triple_budget A ha v
          have he : (13-1).choose 2 * 3 = 198 := by decide
          simpa only [he] using hh
    have hh : 0 ≤ rowCoeff c (R.index v).val (signature C (neighbors A v)) := by omega
    simpa only [rowCoeff,signature_intDot,rv] using hh
  have hcv (d : Fin 15) : 0 ≤ cv d := by
    have hm := signature_distribute R (colNeighbors A d)
    have hd : ((cc c)[(C.index d).val]!).1 = colDegree A d := by
      rw [getBang_eq_get]
      exact C.label_eq d
    have hcond := hcol (C.index d).val (by simp)
      (signature R (colNeighbors A d)) (by simpa only [hd, colDegree] using hm)
    have hh : 0 ≤ colCoeff c (C.index d).val (signature R (colNeighbors A d)) := by
      rcases hcond with hh | hb
      · exact hh
      · obtain ⟨hl,hle,hbad⟩ := hb
        obtain ⟨t,ht,hcard,hweight⟩ := realize_subsignature R (colNeighbors A d)
          (badChoice c (signature R (colNeighbors A d))) hl hle
        have hu := hlocal d t ht
        rw [hcard,hweight] at hu
        omega
    simpa only [colCoeff,signature_intDot,cv] using hh
  have hsa : (∑ v, alpha c (R.index v).val) =
      intDot ((rc c).map Prod.snd) ((List.range (rc c).length).map (alpha c)) := by
    rw [sizes_as_ofFn,range_map_ofFn,intDot_ofFn]
    simpa only [R.size_eq] using sum_by_class_int R Finset.univ (fun i => alpha c i.val)
  have hsb : (∑ d, beta c (C.index d).val) =
      intDot ((cc c).map Prod.snd) ((List.range (cc c).length).map (beta c)) := by
    rw [sizes_as_ofFn,range_map_ofFn,intDot_ofFn]
    simpa only [C.size_eq] using sum_by_class_int C Finset.univ (fun i => beta c i.val)
  have hcross : (∑ v, ∑ d ∈ neighbors A v, gamma c (R.index v).val (C.index d).val) =
      ∑ d, ∑ v ∈ colNeighbors A d, gamma c (R.index v).val (C.index d).val := by
    simp only [neighbors,colNeighbors,Finset.sum_filter]
    exact Finset.sum_comm
  have htotal : (∑ v, rv v) + (∑ d, cv d) = rhs c := by
    simp only [rv,cv,Finset.sum_add_distrib,Finset.sum_sub_distrib]
    rw [hcross,hsa,hsb]
    unfold rhs
    omega
  have hsr := Finset.sum_nonneg (fun v (_ : v ∈ Finset.univ) => hrv v)
  have hsc := Finset.sum_nonneg (fun d (_ : d ∈ Finset.univ) => hcv d)
  omega

end Full1315

/- ==================== MatrixProfiles ==================== -/

open scoped BigOperators
open Zarankiewicz1315.Certificates
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def sortedDegrees {n : Nat} (D : Fin n → Nat) : List Nat :=
  (List.ofFn D).mergeSort (· ≤ ·)

theorem sortedDegrees_perm {n : Nat} (D : Fin n → Nat) :
    (sortedDegrees D).Perm (List.ofFn D) := List.mergeSort_perm _ _

theorem sortedDegrees_length {n : Nat} (D : Fin n → Nat) : (sortedDegrees D).length = n := by
  rw [(sortedDegrees_perm D).length_eq]
  simp

theorem sortedDegrees_pairwise {n : Nat} (D : Fin n → Nat) :
    (sortedDegrees D).Pairwise (· ≤ ·) := List.pairwise_mergeSort' _ _

theorem sortedDegrees_sum {n : Nat} (D : Fin n → Nat) (f : Nat → Nat) :
    ((sortedDegrees D).map f).sum = ∑ i, f (D i) := by
  rw [((sortedDegrees_perm D).map f).sum_eq,List.map_ofFn,List.sum_ofFn]
  rfl

theorem sortedDegrees_bound {n : Nat} (D : Fin n → Nat) (b : Nat) (hb : ∀ i, D i ≤ b) :
    ∀ d ∈ sortedDegrees D, d ≤ b := by
  intro d hd
  have hh := (sortedDegrees_perm D).mem_iff.mp hd
  obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hh
  exact hb i

theorem row_degree_bound {m n : Nat} (A : Grid m n) (i : Fin m) : rowDegree A i ≤ n := by
  simpa only [rowDegree,Fintype.card_fin] using Finset.card_le_univ (neighbors A i)

theorem col_degree_bound {m n : Nat} (A : Grid m n) (i : Fin n) : colDegree A i ≤ m := by
  simpa only [colDegree,Fintype.card_fin] using Finset.card_le_univ (colNeighbors A i)

theorem moment_pointwise (a : Nat) (ha : a ≤ 15) : 16*a ≤ a*(a-1)+72 := by
  interval_cases a <;> decide

theorem moment_lower (A : Grid 13 15) (he : edges A = 115) :
    904 ≤ ∑ i, rowDegree A i * (rowDegree A i - 1) := by
  have hh := Finset.sum_le_sum (s := (Finset.univ : Finset (Fin 13)))
    (fun i _ => moment_pointwise (rowDegree A i) (row_degree_bound A i))
  simp only [Finset.sum_add_distrib,← Finset.mul_sum,Finset.sum_const,
    Finset.card_univ,Fintype.card_fin,smul_eq_mul] at hh
  change 16 * edges A ≤ _ at hh
  rw [he] at hh
  omega

theorem choose3_small (d : Nat) (hd : d ≤ 13) : choose3 d = d.choose 3 := by
  interval_cases d <;> decide

theorem matrix_certificate (A : Grid 13 15) (ha : avoids A 3 4) (he : edges A = 115)
    (hm : (∑ i, rowDegree A i * (rowDegree A i - 1)) ≤ ∑ d, w (colDegree A d)) :
    ∃ c : Case, StronglyCertified c ∧
      c.rows.Perm (List.ofFn (rowDegree A)) ∧ c.cols.Perm (List.ofFn (colDegree A)) := by
  let rs := sortedDegrees (rowDegree A)
  let cs := sortedDegrees (colDegree A)
  have hrlen : rs.length = 13 := sortedDegrees_length _
  have hclen : cs.length = 15 := sortedDegrees_length _
  have hrsum : rs.sum = 115 := by
    have hh := sortedDegrees_sum (rowDegree A) id
    change (sortedDegrees (rowDegree A)).sum = 115
    calc
      _ = ∑ i, rowDegree A i := by simpa only [List.map_id_fun,id_eq] using hh
      _ = 115 := he
  have hcsum : cs.sum = 115 := by
    have hh := sortedDegrees_sum (colDegree A) id
    simpa only [List.map_id_fun,id_eq,colDegree_sum,he] using hh
  have htri : (cs.map choose3).sum ≤ 858 := by
    rw [sortedDegrees_sum]
    calc
      _ = ∑ d, (colDegree A d).choose 3 := by
        apply Finset.sum_congr rfl
        intro d _
        exact choose3_small _ (col_degree_bound A d)
      _ ≤ 858 := by
        have hh := triple_moment A ha
        have hc : (13 : Nat).choose 3 * 3 = 858 := by decide
        simpa only [hc] using hh
  have hrmom : (rs.map (fun a => a*(a-1))).sum ≤ (cs.map w).sum := by
    simpa only [rs,cs,sortedDegrees_sum] using hm
  have hcmin : 904 ≤ (cs.map w).sum := by
    rw [sortedDegrees_sum]
    exact (moment_lower A he).trans hm
  have hmem := expectedPairs_complete rs cs hrlen hclen hrsum hcsum
    (sortedDegrees_pairwise _) (sortedDegrees_pairwise _)
    (sortedDegrees_bound _ _ (row_degree_bound A)) (sortedDegrees_bound _ _ (col_degree_bound A))
    htri hrmom hcmin
  obtain ⟨c,hcert,hrows,hcols⟩ := certificate_of_profiles rs cs hmem
  refine ⟨c,hcert,?_,?_⟩
  · rw [hrows]
    exact sortedDegrees_perm _
  · rw [hcols]
    exact sortedDegrees_perm _

end Full1315

/- ==================== Thinning ==================== -/

open scoped BigOperators
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def occupied {m n : Nat} (A : Grid m n) : Finset (Fin m × Fin n) :=
  Finset.univ.filter (fun p => (A p.1).getLsbD p.2.val = true)

theorem occupied_card {m n : Nat} (A : Grid m n) : (occupied A).card = edges A := by
  simp only [occupied, Finset.card_filter, edges, rowDegree, neighbors]
  rw [Fintype.sum_prod_type]

def gridFromSet {m n : Nat} (s : Finset (Fin m × Fin n)) : Grid m n :=
  fun i => wordOfFn (fun j => decide ((i,j) ∈ s))

theorem occupied_gridFromSet {m n : Nat} (s : Finset (Fin m × Fin n)) :
    occupied (gridFromSet s) = s := by
  ext p
  simp only [occupied, Finset.mem_filter, Finset.mem_univ, true_and]
  change ((wordOfFn (fun j => decide ((p.1,j) ∈ s))).getLsbD p.2.val = true) ↔ p ∈ s
  rw [bit_wordOfFn _ p.2]
  simp

theorem avoids_subset {m n k l : Nat} (A B : Grid m n) (ha : avoids A k l)
    (hsub : occupied B ⊆ occupied A) : avoids B k l := by
  intro s hs
  apply lt_of_le_of_lt _ (ha s hs)
  apply Finset.card_le_card
  intro c hc
  obtain ⟨_,hc⟩ := Finset.mem_filter.mp hc
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_univ _, ?_⟩
  intro i hi
  have he : (i,c) ∈ occupied B := by simp [occupied,hc i hi]
  exact (Finset.mem_filter.mp (hsub he)).2

theorem thin_to {m n k l e : Nat} (A : Grid m n) (ha : avoids A k l) (he : e ≤ edges A) :
    ∃ B : Grid m n, avoids B k l ∧ edges B = e := by
  rw [← occupied_card] at he
  obtain ⟨s,hs,hcard⟩ := Finset.exists_subset_card_eq he
  refine ⟨gridFromSet s,?_,?_⟩
  · apply avoids_subset A _ ha
    simpa only [occupied_gridFromSet] using hs
  · rw [← occupied_card,occupied_gridFromSet,hcard]

end Full1315

/- ==================== Conclusion ==================== -/

open scoped BigOperators
open Zarankiewicz1315.Certificates
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

theorem no_115 (A : Grid 13 15) (ha : avoids A 3 4) (he : edges A = 115) : False := by
  have hw : 115 ≤ Zarankiewicz1315.weight A := by rw [← edges13_eq,he]
  have hm : (∑ i, rowDegree A i * (rowDegree A i-1)) ≤ ∑ d, w (colDegree A d) :=
    global_row_moment A ha hw
  obtain ⟨c,hcert,hr,hc⟩ := matrix_certificate A ha he hm
  apply certificate_contradiction A ha ?_ c hcert hr hc
  intro d s hs
  exact neighborhood_bound A ha hw d s hs

end Full1315

namespace Zarankiewicz1315
open Full1315

/-- Every 13-by-15 zero-one matrix with no three-by-four all-one submatrix
has at most 114 ones. The orientation is three rows and four columns. -/
theorem upper_bound (A : Matrix) (ha : Avoids34 A) : weight A ≤ 114 := by
  by_contra h
  have he : 115 ≤ edges A := by rw [edges13_eq]; omega
  obtain ⟨B,hB,hcount⟩ := thin_to A ((avoids13_iff A).mpr ha) he
  exact no_115 B hB hcount

/-- The exact oriented Zarankiewicz number is 114. -/
theorem exact_value : IsExtremalValue 114 := ⟨lower_bound,upper_bound⟩

#print axioms upper_bound
#print axioms exact_value
#print exact_value
end Zarankiewicz1315
