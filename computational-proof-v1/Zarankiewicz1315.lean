open scoped BigOperators
open Zarankiewicz1315.Certificates
namespace Full1315
set_option maxHeartbeats 0
set_option maxRecDepth 100000

theorem list_sum_bounds (xs : List Nat) (lo hi : Nat)
    (h : ∀ x ∈ xs, lo ≤ x ∧ x ≤ hi) :
    xs.length * lo ≤ xs.sum ∧ xs.sum ≤ xs.length * hi := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
    have hx := h x (by simp)
    have ht := ih (fun y hy => h y (by simp [hy]))
    simp only [List.length_cons, List.sum_cons, Nat.add_mul]
    omega

theorem mem_columnsVisit (xs : List Nat) (lo cost bound : Nat)
    (hs : xs.Pairwise (· ≤ ·))
    (hb : ∀ x ∈ xs, lo ≤ x ∧ x ≤ 13)
    (hc : cost + (xs.map choose3).sum ≤ 858)
    (hz : 904 ≤ bound + (xs.map w).sum) :
    xs ∈ columnsVisit xs.length xs.sum lo cost bound := by
  induction xs generalizing lo cost bound with
  | nil => simp [columnsVisit] at *; omega
  | cons x xs ih =>
    obtain ⟨hfirst, htail⟩ := List.pairwise_cons.mp hs
    have hhead := hb x (by simp)
    have hrest : ∀ y ∈ xs, x ≤ y ∧ y ≤ 13 := by
      intro y hy
      exact ⟨hfirst y hy, (hb y (by simp [hy])).2⟩
    have hlower := list_sum_bounds (x::xs) lo 13 hb
    have hsortedLower := list_sum_bounds (x::xs) x 13 (by
      intro y hy
      rcases List.mem_cons.mp hy with rfl | hy
      · exact ⟨le_rfl,hhead.2⟩
      · exact hrest y hy)
    have hdiv : x ≤ (x+xs.sum)/(xs.length+1) := by
      apply (Nat.le_div_iff_mul_le (by omega)).mpr
      simpa only [List.length_cons, List.sum_cons, Nat.mul_comm] using hsortedLower.1
    have hn : ¬ (x+xs.sum < (xs.length+1)*lo ∨ (xs.length+1)*13 < x+xs.sum ∨ 858 < cost) := by
      simp only [List.length_cons, List.sum_cons] at hlower
      omega
    simp only [List.length_cons, List.sum_cons, columnsVisit]
    rw [if_neg (by simpa only [Bool.or_eq_true, decide_eq_true_eq, or_assoc] using hn)]
    apply List.mem_flatMap.mpr
    refine ⟨x, ?_, ?_⟩
    · simp only [List.mem_filter, List.mem_range, Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨by omega,hhead.1,hdiv⟩
    · rw [Nat.add_sub_cancel_left]
      apply List.mem_map.mpr
      refine ⟨xs, ih x (cost+choose3 x) (bound+w x) htail hrest ?_ ?_, rfl⟩
      · simp only [List.map_cons, List.sum_cons] at hc
        omega
      · simp only [List.map_cons, List.sum_cons] at hz
        omega

theorem mem_rowsVisit (xs : List Nat) (lo cost cap : Nat)
    (hs : xs.Pairwise (· ≤ ·))
    (hb : ∀ x ∈ xs, lo ≤ x ∧ x ≤ 15)
    (hc : cost + (xs.map (fun d => d*(d-1))).sum ≤ cap) :
    xs ∈ rowsVisit xs.length xs.sum lo cost cap := by
  induction xs generalizing lo cost cap with
  | nil => simp [rowsVisit] at *; omega
  | cons x xs ih =>
    obtain ⟨hfirst, htail⟩ := List.pairwise_cons.mp hs
    have hhead := hb x (by simp)
    have hrest : ∀ y ∈ xs, x ≤ y ∧ y ≤ 15 := by
      intro y hy
      exact ⟨hfirst y hy, (hb y (by simp [hy])).2⟩
    have hlower := list_sum_bounds (x::xs) lo 15 hb
    have hsortedLower := list_sum_bounds (x::xs) x 15 (by
      intro y hy
      rcases List.mem_cons.mp hy with rfl | hy
      · exact ⟨le_rfl,hhead.2⟩
      · exact hrest y hy)
    have hdiv : x ≤ (x+xs.sum)/(xs.length+1) := by
      apply (Nat.le_div_iff_mul_le (by omega)).mpr
      simpa only [List.length_cons, List.sum_cons, Nat.mul_comm] using hsortedLower.1
    have hn : ¬ (x+xs.sum < (xs.length+1)*lo ∨ (xs.length+1)*15 < x+xs.sum ∨ cap < cost) := by
      simp only [List.length_cons, List.sum_cons] at hlower
      omega
    simp only [List.length_cons, List.sum_cons, rowsVisit]
    rw [if_neg (by simpa only [Bool.or_eq_true, decide_eq_true_eq, or_assoc] using hn)]
    apply List.mem_flatMap.mpr
    refine ⟨x, ?_, ?_⟩
    · simp only [List.mem_filter, List.mem_range, Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨by omega,hhead.1,hdiv⟩
    · rw [Nat.add_sub_cancel_left]
      apply List.mem_map.mpr
      refine ⟨xs, ih x (cost+x*(x-1)) cap htail hrest ?_, rfl⟩
      simp only [List.map_cons, List.sum_cons] at hc
      omega

theorem mem_distribute (xs caps : List Nat) (hs : xs.sum = n)
    (hb : List.Forall₂ (· ≤ ·) xs caps) : xs ∈ distribute caps n := by
  induction hb generalizing n with
  | nil => simp [distribute] at *; omega
  | @cons a b xs caps hab htail ih =>
    simp only [List.sum_cons] at hs
    simp only [distribute]
    apply List.mem_flatMap.mpr
    refine ⟨a, ?_, ?_⟩
    · simp only [List.mem_range]
      omega
    · apply List.mem_map.mpr
      refine ⟨xs, ih (by omega), rfl⟩

end Full1315

